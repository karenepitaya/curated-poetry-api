          "id": "line-1",
          "hans": "虢国夫人承主恩，",
          "hant": "虢國夫人承主恩，"
        },
        {
          "id": "line-2",
          "hans": "平明骑马入宫门。",
          "hant": "平明騎馬入宮門。"
        },
        {
          "id": "line-3",
          "hans": "却嫌脂粉污颜色，",
          "hant": "卻嫌脂粉污顏色，"
        },
        {
          "id": "line-4",
          "hans": "淡扫蛾眉朝至尊。",
          "hant": "淡掃蛾眉朝至尊。"
        }
      ]
    }
