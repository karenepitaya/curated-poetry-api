        {
          "id": "line-2",
          "hans": "石矶西畔问渔船。",
          "hant": "石磯西畔問漁船。"
        },
        {
          "id": "line-3",
          "hans": "桃花尽日随流水，",
          "hant": "桃花盡日隨流水，"
        },
        {
          "id": "line-4",
          "hans": "洞在清溪何处边。",
          "hant": "洞在清谿何處邊。"
        }
