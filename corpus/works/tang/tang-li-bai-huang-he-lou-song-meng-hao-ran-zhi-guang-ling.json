          "id": "line-1",
          "hans": "故人西辞黄鹤楼，",
          "hant": "故人西辭黃鶴樓，"
        },
        {
          "id": "line-2",
          "hans": "烟花三月下扬州。",
          "hant": "煙花三月下揚州。"
        },
        {
          "id": "line-3",
          "hans": "孤帆远影碧山尽，",
          "hant": "孤帆遠影碧山盡，"
        },
        {
          "id": "line-4",
          "hans": "惟见长江天际流。",
          "hant": "惟見長江天際流。"
        }
      ]
