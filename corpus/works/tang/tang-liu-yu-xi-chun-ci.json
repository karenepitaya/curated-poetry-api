      "lines": [
        {
          "id": "line-1",
          "hans": "新妆宜面下朱楼，",
          "hant": "新妝宜面下朱樓，"
        },
        {
          "id": "line-2",
          "hans": "深锁春光一院愁。",
          "hant": "深鎖春光一院愁。"
        },
        {
          "id": "line-3",
          "hans": "行到中庭数花朵，",
          "hant": "行到中庭數花朵，"
        },
        {
          "id": "line-4",
          "hans": "蜻蜓飞上玉搔头。",
          "hant": "蜻蜓飛上玉搔頭。"
        }
      ]
