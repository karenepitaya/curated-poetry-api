          "id": "line-1",
          "hans": "少小离家老大回，",
          "hant": "少小離家老大回，"
        },
        {
          "id": "line-2",
          "hans": "乡音无改鬓毛催。",
          "hant": "鄉音無改鬢毛催。"
        },
        {
          "id": "line-3",
          "hans": "儿童相见不相识，",
          "hant": "兒童相見不相識，"
        },
        {
          "id": "line-4",
          "hans": "笑问客从何处来。",
          "hant": "笑問客從何處來。"
        }
      ]
