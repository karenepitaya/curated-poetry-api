          "id": "line-1",
          "hans": "岐王宅里寻常见，",
          "hant": "岐王宅裏尋常見，"
        },
        {
          "id": "line-2",
          "hans": "崔九堂前几度闻。",
          "hant": "崔九堂前幾度聞。"
        },
        {
          "id": "line-3",
          "hans": "正是江南好风景，",
          "hant": "正是江南好風景，"
        },
        {
          "id": "line-4",
          "hans": "落花时节又逢君。",
          "hant": "落花時節又逢君。"
        }
      ]
    }
