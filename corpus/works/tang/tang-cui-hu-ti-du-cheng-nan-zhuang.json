          "id": "line-1",
          "hans": "去年今日此门中，",
          "hant": "去年今日此門中，"
        },
        {
          "id": "line-2",
          "hans": "人面桃花相映红。",
          "hant": "人面桃花相映紅。"
        },
        {
          "id": "line-3",
          "hans": "人面不知何处去，",
          "hant": "人面不知何處去，"
        },
        {
          "id": "line-4",
          "hans": "桃花依旧笑春风。",
          "hant": "桃花依舊笑春風。"
        }
      ]
