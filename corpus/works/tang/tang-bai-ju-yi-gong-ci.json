      "lines": [
        {
          "id": "line-1",
          "hans": "泪尽罗巾梦不成，",
          "hant": "淚盡羅巾夢不成，"
        },
        {
          "id": "line-2",
          "hans": "夜深前殿按歌声。",
          "hant": "夜深前殿按歌聲。"
        },
        {
          "id": "line-3",
          "hans": "红颜未老恩先断，",
          "hant": "紅顏未老恩先斷，"
        },
        {
          "id": "line-4",
          "hans": "斜倚熏笼坐到明。",
          "hant": "斜倚熏籠坐到明。"
        }
      ]
    }
  ],
