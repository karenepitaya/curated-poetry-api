      "lines": [
        {
          "id": "line-1",
          "hans": "禁门宫树月痕过，",
          "hant": "禁門宮樹月痕過，"
        },
        {
          "id": "line-2",
          "hans": "媚眼惟看宿鹭窠。",
          "hant": "媚眼惟看宿鷺窠。"
        },
        {
          "id": "line-3",
          "hans": "斜拔玉钗灯影畔，",
          "hant": "斜拔玉釵燈影畔，"
        },
        {
          "id": "line-4",
          "hans": "剔开红焰救飞蛾。",
          "hant": "剔開紅燄救飛蛾。"
        }
      ]
    }
  ],
