      "lines": [
        {
          "id": "line-1",
          "hans": "独怜幽草涧边生，",
          "hant": "獨憐幽草澗邊生，"
        },
        {
          "id": "line-2",
          "hans": "上有黄鹂深树鸣。",
          "hant": "上有黃鸝深樹鳴。"
        },
        {
          "id": "line-3",
          "hans": "春潮带雨晚来急，",
          "hant": "春潮帶雨晚來急，"
        },
        {
          "id": "line-4",
          "hans": "野渡无人舟自横。",
          "hant": "野渡無人舟自橫。"
        }
      ]
    }
