      "lines": [
        {
          "id": "line-1",
          "hans": "朝辞白帝彩云间，",
          "hant": "朝辭白帝彩雲間，"
        },
        {
          "id": "line-2",
          "hans": "千里江陵一日还。",
          "hant": "千里江陵一日還。"
        },
        {
          "id": "line-3",
          "hans": "两岸猿声啼不住，",
          "hant": "兩岸猿聲啼不住，"
        },
        {
          "id": "line-4",
          "hans": "轻舟已过万重山。",
          "hant": "輕舟已過萬重山。"
        }
      ]
    }
