          "id": "line-1",
          "hans": "日光斜照集灵台，",
          "hant": "日光斜照集靈臺，"
        },
        {
          "id": "line-2",
          "hans": "红树花迎晓露开。",
          "hant": "紅樹花迎曉露開。"
        },
        {
          "id": "line-3",
          "hans": "昨夜上皇新授箓，",
          "hant": "昨夜上皇新授籙，"
        },
        {
          "id": "line-4",
          "hans": "太真含笑入帘来。",
          "hant": "太真含笑入簾來。"
        }
