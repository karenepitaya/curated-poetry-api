          "id": "line-1",
          "hans": "玉楼天半起笙歌，",
          "hant": "玉樓天半起笙歌，"
        },
        {
          "id": "line-2",
          "hans": "风送宫嫔笑语和。",
          "hant": "風送宮嬪笑語和。"
        },
        {
          "id": "line-3",
          "hans": "月殿影开闻夜漏，",
          "hant": "月殿影開聞夜漏，"
        },
        {
          "id": "line-4",
          "hans": "水精帘卷近秋河。",
          "hant": "水精簾捲近秋河。"
        }
      ]
