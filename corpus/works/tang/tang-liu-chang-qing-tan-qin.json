      "lines": [
        {
          "id": "line-1",
          "hans": "泠泠七弦上，",
          "hant": "泠泠七絃上，"
        },
        {
          "id": "line-2",
          "hans": "静听松风寒。",
          "hant": "靜聽松風寒。"
        },
        {
          "id": "line-3",
          "hans": "古调虽自爱，",
          "hant": "古調雖自愛，"
        },
        {
          "id": "line-4",
          "hans": "今人多不弹。",
          "hant": "今人多不彈。"
        }
      ]
    }
