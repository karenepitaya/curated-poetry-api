      "lines": [
        {
          "id": "line-1",
          "hans": "春城无处不飞花，",
          "hant": "春城無處不飛花，"
        },
        {
          "id": "line-2",
          "hans": "寒食东风御柳斜。",
          "hant": "寒食東風御柳斜。"
        },
        {
          "id": "line-3",
          "hans": "日暮汉宫传蜡烛，",
          "hant": "日暮漢宮傳蠟燭，"
        },
        {
          "id": "line-4",
          "hans": "轻烟散入五侯家。",
          "hant": "輕煙散入五侯家。"
        }
      ]
    }
