      "lines": [
        {
          "id": "line-1",
          "hans": "故园东望路漫漫，",
          "hant": "故園東望路漫漫，"
        },
        {
          "id": "line-2",
          "hans": "双袖龙钟泪不干。",
          "hant": "雙袖龍鍾淚不乾。"
        },
        {
          "id": "line-3",
          "hans": "马上相逢无纸笔，",
          "hant": "馬上相逢無紙筆，"
        },
        {
          "id": "line-4",
          "hans": "凭君传语报平安。",
          "hant": "憑君傳語報平安。"
        }
      ]
    }
