  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "怒发冲冠，凭阑处、潇潇雨歇。",
          "hant": "怒髮衝冠，憑闌處、瀟瀟雨歇。"
        },
        {
          "id": "line-2",
          "hans": "抬望眼、仰天长啸，壮怀激烈。",
          "hant": "抬望眼、仰天長嘯，壯懷激烈。"
        },
        {
          "id": "line-3",
          "hans": "三十功名尘与土，八千里路云和月。",
          "hant": "三十功名塵與土，八千里路雲和月。"
        },
        {
          "id": "line-4",
          "hans": "莫等闲、白了少年头，空悲切。",
          "hant": "莫等閒、白了少年頭，空悲切。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "靖康耻，犹未雪。",
          "hant": "靖康恥，猶未雪。"
        },
        {
          "id": "line-6",
          "hans": "臣子恨，何时灭。",
          "hant": "臣子恨，何時滅。"
        },
        {
          "id": "line-7",
          "hans": "驾长车踏破，贺兰山缺。",
          "hant": "駕長車踏破，賀蘭山缺。"
        },
        {
          "id": "line-8",
          "hans": "壮志饥餐胡虏肉，笑谈渴饮匈奴血。",
          "hant": "壯志飢餐胡虜肉，笑談渴飲匈奴血。"
        },
        {
          "id": "line-9",
          "hans": "待从头、收拾旧山河，朝天阙。",
          "hant": "待從頭、收拾舊山河，朝天闕。"
        }
      ]
    }
  ],
