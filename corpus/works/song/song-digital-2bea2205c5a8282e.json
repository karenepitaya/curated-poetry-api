  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "小径红稀，芳郊绿遍。",
          "hant": "小徑紅稀，芳郊綠遍。"
        },
        {
          "id": "line-2",
          "hans": "高台树色阴阴见。",
          "hant": "高臺樹色陰陰見。"
        },
        {
          "id": "line-3",
          "hans": "春风不解禁杨花，乱扑行人面。",
          "hant": "春風不解禁楊花，亂撲行人面。"
        },
        {
          "id": "line-4",
          "hans": "翠叶藏莺，朱帘隔燕。",
          "hant": "翠葉藏鶯，朱簾隔燕。"
        },
        {
          "id": "line-5",
          "hans": "炉香静逐游丝转。",
          "hant": "爐香靜逐遊絲轉。"
        },
        {
          "id": "line-6",
          "hans": "一场愁梦酒醒时，斜阳却照深深院。",
          "hant": "一場愁夢酒醒時，斜陽卻照深深院。"
        }
      ]
    }
  ],
