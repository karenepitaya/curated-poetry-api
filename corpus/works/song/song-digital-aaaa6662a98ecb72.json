      "lines": [
        {
          "id": "line-1",
          "hans": "城上风光莺语乱。",
          "hant": "城上風光鶯語亂。"
        },
        {
          "id": "line-2",
          "hans": "城下烟波春拍岸。",
          "hant": "城下煙波春拍岸。"
        },
        {
          "id": "line-3",
          "hans": "绿杨芳草几时休，泪眼愁肠先已断。",
          "hant": "綠楊芳草幾時休，淚眼愁腸先已斷。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "情怀渐变成衰晚。",
          "hant": "情懷漸變成衰晚。"
        },
        {
          "id": "line-5",
          "hans": "鸾鉴朱颜惊暗换。",
          "hant": "鸞鑑朱顏驚暗換。"
        },
        {
          "id": "line-6",
          "hans": "昔年多病厌芳尊，今日芳尊惟恐浅。",
          "hant": "昔年多病厭芳尊，今日芳尊惟恐淺。"
        }
      ]
    }
  ],
