  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "燕鸿过後莺归去。",
          "hant": "燕鴻過後鶯歸去。"
        },
        {
          "id": "line-2",
          "hans": "细算浮生千万绪。",
          "hant": "細算浮生千萬緒。"
        },
        {
          "id": "line-3",
          "hans": "长於春梦几多时，散似秋云无觅处。",
          "hant": "長於春夢幾多時，散似秋雲無覓處。"
        },
        {
          "id": "line-4",
          "hans": "闻琴解佩神仙侣。",
          "hant": "聞琴解佩神仙侶。"
        },
        {
          "id": "line-5",
          "hans": "挽断罗衣留不住。",
          "hant": "挽斷羅衣留不住。"
        },
        {
          "id": "line-6",
          "hans": "劝君莫作独醒人，烂醉花间应有数。",
          "hant": "勸君莫作獨醒人，爛醉花間應有數。"
        }
      ]
    }
  ],
