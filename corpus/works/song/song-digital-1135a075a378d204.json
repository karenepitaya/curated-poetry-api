      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "肥水东流无尽期。",
          "hant": "肥水東流無盡期。"
        },
        {
          "id": "line-2",
          "hans": "当初不合种相思。",
          "hant": "當初不合種相思。"
        },
        {
          "id": "line-3",
          "hans": "梦中未比丹青见，暗里忽惊山鸟啼。",
          "hant": "夢中未比丹青見，暗裏忽驚山鳥啼。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "春未绿，鬓先丝。",
          "hant": "春未綠，鬢先絲。"
        },
        {
          "id": "line-5",
          "hans": "人间别久不成悲。",
          "hant": "人間別久不成悲。"
        },
        {
          "id": "line-6",
          "hans": "谁教岁岁红莲夜，两处沈吟各自知。",
          "hant": "誰教歲歲紅蓮夜，兩處沈吟各自知。"
        }
      ]
    }
  ],
