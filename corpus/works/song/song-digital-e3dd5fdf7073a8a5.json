  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "渐吹尽、枝头香絮。",
          "hant": "漸吹盡、枝頭香絮。"
        },
        {
          "id": "line-2",
          "hans": "是处人家，绿深门户。",
          "hant": "是處人家，綠深門戶。"
        },
        {
          "id": "line-3",
          "hans": "远浦萦回，暮帆零乱向何许。",
          "hant": "遠浦縈迴，暮帆零亂向何許。"
        },
        {
          "id": "line-4",
          "hans": "阅人多矣，谁得似、长亭树。",
          "hant": "閱人多矣，誰得似、長亭樹。"
        },
        {
          "id": "line-5",
          "hans": "树若有情时，不会得、青青如此。",
          "hant": "樹若有情時，不會得、青青如此。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-6",
          "hans": "日暮。",
          "hant": "日暮。"
        },
        {
          "id": "line-7",
          "hans": "望高城不见，只见乱山无数。",
          "hant": "望高城不見，只見亂山無數。"
        },
        {
          "id": "line-8",
          "hans": "韦郎去也，怎忘得、玉环分付。",
          "hant": "韋郎去也，怎忘得、玉環分付。"
        },
        {
          "id": "line-9",
          "hans": "第一是、早早归来，怕红萼、无人为主。",
          "hant": "第一是、早早歸來，怕紅萼、無人爲主。"
        },
        {
          "id": "line-10",
          "hans": "算空有并刀，难翦离愁千缕。",
          "hant": "算空有並刀，難翦離愁千縷。"
        }
      ]
    }
  ],
