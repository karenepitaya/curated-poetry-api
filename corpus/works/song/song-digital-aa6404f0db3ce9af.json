  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "佳丽地。",
          "hant": "佳麗地。"
        },
        {
          "id": "line-2",
          "hans": "南朝盛事谁记。",
          "hant": "南朝盛事誰記。"
        },
        {
          "id": "line-3",
          "hans": "山围故国绕清江，髻鬟对起。",
          "hant": "山圍故國繞清江，髻鬟對起。"
        },
        {
          "id": "line-4",
          "hans": "怒涛寂寞打孤城，风樯遥度天际。",
          "hant": "怒濤寂寞打孤城，風檣遙度天際。"
        },
        {
          "id": "line-5",
          "hans": "断崖树，犹倒倚。",
          "hant": "斷崖樹，猶倒倚。"
        },
        {
          "id": "line-6",
          "hans": "莫愁艇子曾系。",
          "hant": "莫愁艇子曾系。"
        },
        {
          "id": "line-7",
          "hans": "空馀旧迹郁苍苍，雾沈半垒。",
          "hant": "空餘舊跡鬱蒼蒼，霧沈半壘。"
        },
        {
          "id": "line-8",
          "hans": "夜深月过女墙来，赏心东望淮水。",
          "hant": "夜深月過女牆來，賞心東望淮水。"
        },
        {
          "id": "line-9",
          "hans": "酒旗戏鼓甚处市。",
          "hant": "酒旗戲鼓甚處市。"
        },
        {
          "id": "line-10",
          "hans": "想依稀、王谢邻里。",
          "hant": "想依稀、王謝鄰里。"
        },
        {
          "id": "line-11",
          "hans": "燕子不知何世。",
          "hant": "燕子不知何世。"
        },
        {
          "id": "line-12",
          "hans": "入寻常、巷陌人家，相对如说兴亡，斜阳里。",
          "hant": "入尋常、巷陌人家，相對如說興亡，斜陽裏。"
        }
      ]
    }
  ],
