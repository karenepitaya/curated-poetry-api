      "lines": [
        {
          "id": "line-1",
          "hans": "无穷官柳，无情画舸，无根行客。",
          "hant": "無窮官柳，無情畫舸，無根行客。"
        },
        {
          "id": "line-2",
          "hans": "南山尚相送，只高城人隔。",
          "hant": "南山尚相送，只高城人隔。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-3",
          "hans": "罨画园林溪绀碧。",
          "hant": "罨畫園林溪紺碧。"
        },
        {
          "id": "line-4",
          "hans": "算重来、尽成陈迹。",
          "hant": "算重來、盡成陳跡。"
        },
        {
          "id": "line-5",
          "hans": "刘郎鬓如此，况桃花颜色。",
          "hant": "劉郎鬢如此，況桃花顏色。"
        }
      ]
    }
  ],
