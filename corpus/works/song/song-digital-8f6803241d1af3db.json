  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "润玉笼绡，檀樱倚扇。",
          "hant": "潤玉籠綃，檀櫻倚扇。"
        },
        {
          "id": "line-2",
          "hans": "绣圈犹带脂香浅。",
          "hant": "繡圈猶帶脂香淺。"
        },
        {
          "id": "line-3",
          "hans": "榴心空叠舞裙红，艾枝应压愁鬟乱。",
          "hant": "榴心空疊舞裙紅，艾枝應壓愁鬟亂。"
        },
        {
          "id": "line-4",
          "hans": "午梦千山，窗阴一箭。",
          "hant": "午夢千山，窗陰一箭。"
        },
        {
          "id": "line-5",
          "hans": "香瘢新褪红丝腕。",
          "hant": "香瘢新褪紅絲腕。"
        },
        {
          "id": "line-6",
          "hans": "隔江人在雨声中，晚风菰叶生秋怨。",
          "hant": "隔江人在雨聲中，晚風菰葉生秋怨。"
        }
      ]
    }
  ],
