  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "空城晓月。",
          "hant": "空城曉月。"
        },
        {
          "id": "line-2",
          "hans": "吹入垂杨陌。",
          "hant": "吹入垂楊陌。"
        },
        {
          "id": "line-3",
          "hans": "马上单衣寒恻恻。",
          "hant": "馬上單衣寒惻惻。"
        },
        {
          "id": "line-4",
          "hans": "看尽鹅黄嫩绿，都是江南旧相识。",
          "hant": "看盡鵝黃嫩綠，都是江南舊相識。"
        },
        {
          "id": "line-5",
          "hans": "正岑寂。",
          "hant": "正岑寂。"
        },
        {
          "id": "line-6",
          "hans": "明朝又寒食。",
          "hant": "明朝又寒食。"
        },
        {
          "id": "line-7",
          "hans": "强携酒、小桥宅，怕梨花落尽成秋色。",
          "hant": "強攜酒、小橋宅，怕梨花落盡成秋色。"
        },
        {
          "id": "line-8",
          "hans": "燕燕飞来，问春何在，唯有池塘自碧。",
          "hant": "燕燕飛來，問春何在，唯有池塘自碧。"
        }
      ]
    }
  ],
