      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "群芳过後西湖好，狼籍残红。",
          "hant": "羣芳過後西湖好，狼籍殘紅。"
        },
        {
          "id": "line-2",
          "hans": "飞絮蒙蒙。",
          "hant": "飛絮濛濛。"
        },
        {
          "id": "line-3",
          "hans": "垂柳阑干尽日风。",
          "hant": "垂柳闌干盡日風。"
        },
        {
          "id": "line-4",
          "hans": "笙歌散尽游人去，始觉春空。",
          "hant": "笙歌散盡遊人去，始覺春空。"
        },
        {
          "id": "line-5",
          "hans": "垂下帘栊。",
          "hant": "垂下簾櫳。"
        },
        {
          "id": "line-6",
          "hans": "双燕归来细雨中。",
          "hant": "雙燕歸來細雨中。"
        }
      ]
    }
  ],
