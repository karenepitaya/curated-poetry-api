      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "乍暖还轻冷。",
          "hant": "乍暖還輕冷。"
        },
        {
          "id": "line-2",
          "hans": "风雨晚来方定。",
          "hant": "風雨晚來方定。"
        },
        {
          "id": "line-3",
          "hans": "庭轩寂寞近清明，残花中酒，又是去年病。",
          "hant": "庭軒寂寞近清明，殘花中酒，又是去年病。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "楼头画角风吹醒。",
          "hant": "樓頭畫角風吹醒。"
        },
        {
          "id": "line-5",
          "hans": "入夜重门静。",
          "hant": "入夜重門靜。"
        },
        {
          "id": "line-6",
          "hans": "那堪更被明月，隔墙送过秋千影。",
          "hant": "那堪更被明月，隔牆送過鞦韆影。"
        }
      ]
    }
  ],
