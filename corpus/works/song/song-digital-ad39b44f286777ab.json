  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "孤峤蟠烟，层涛蜕月，骊宫夜采铅水。",
          "hant": "孤嶠蟠煙，層濤蛻月，驪宮夜採鉛水。"
        },
        {
          "id": "line-2",
          "hans": "讯远槎风，梦深薇露，化作断魂心字。",
          "hant": "訊遠槎風，夢深薇露，化作斷魂心字。"
        },
        {
          "id": "line-3",
          "hans": "红瓷候火，还乍识、冰环玉指。",
          "hant": "紅瓷候火，還乍識、冰環玉指。"
        },
        {
          "id": "line-4",
          "hans": "一缕萦帘翠影，依稀海天云气。",
          "hant": "一縷縈簾翠影，依稀海天雲氣。"
        },
        {
          "id": "line-5",
          "hans": "几回娇半醉。",
          "hant": "幾回嬌半醉。"
        },
        {
          "id": "line-6",
          "hans": "翦春灯、夜寒花碎。",
          "hant": "翦春燈、夜寒花碎。"
        },
        {
          "id": "line-7",
          "hans": "更好故溪飞雪，小窗深闭。",
          "hant": "更好故溪飛雪，小窗深閉。"
        },
        {
          "id": "line-8",
          "hans": "荀令如今顿老，总忘却、樽前旧风味。",
          "hant": "荀令如今頓老，總忘卻、樽前舊風味。"
        },
        {
          "id": "line-9",
          "hans": "谩惜馀熏，空篝素被。",
          "hant": "謾惜餘燻，空篝素被。"
        }
      ]
    }
  ],
