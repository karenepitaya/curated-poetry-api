      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "燕雁无心，太湖西畔随云去。",
          "hant": "燕雁無心，太湖西畔隨雲去。"
        },
        {
          "id": "line-2",
          "hans": "数峰清苦。",
          "hant": "數峯清苦。"
        },
        {
          "id": "line-3",
          "hans": "商略黄昏雨。",
          "hant": "商略黃昏雨。"
        },
        {
          "id": "line-4",
          "hans": "第四桥边，拟共天随住。",
          "hant": "第四橋邊，擬共天隨住。"
        },
        {
          "id": "line-5",
          "hans": "今何许。",
          "hant": "今何許。"
        },
        {
          "id": "line-6",
          "hans": "凭栏怀古。",
          "hant": "憑欄懷古。"
        },
        {
          "id": "line-7",
          "hans": "残柳参差舞。",
          "hant": "殘柳參差舞。"
        }
      ]
    }
  ],
