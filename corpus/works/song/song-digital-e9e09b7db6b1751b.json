      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "郁孤台下清江水。",
          "hant": "鬱孤臺下清江水。"
        },
        {
          "id": "line-2",
          "hans": "中间多少行人泪。",
          "hant": "中間多少行人淚。"
        },
        {
          "id": "line-3",
          "hans": "西北是长安。",
          "hant": "西北是長安。"
        },
        {
          "id": "line-4",
          "hans": "可怜无数山。",
          "hant": "可憐無數山。"
        },
        {
          "id": "line-5",
          "hans": "青山遮不住。",
          "hant": "青山遮不住。"
        },
        {
          "id": "line-6",
          "hans": "毕竟江流去。",
          "hant": "畢竟江流去。"
        },
        {
          "id": "line-7",
          "hans": "江晚正愁予。",
          "hant": "江晚正愁予。"
        },
        {
          "id": "line-8",
          "hans": "山深闻鹧鸪。",
          "hant": "山深聞鷓鴣。"
        }
      ]
    }
  ],
