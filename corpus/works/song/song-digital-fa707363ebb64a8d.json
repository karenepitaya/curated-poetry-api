  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "绀烟迷雁迹。",
          "hant": "紺煙迷雁跡。"
        },
        {
          "id": "line-2",
          "hans": "渐断鼓零钟，街喧初息。",
          "hant": "漸斷鼓零鍾，街喧初息。"
        },
        {
          "id": "line-3",
          "hans": "风檠背寒壁。",
          "hant": "風檠背寒壁。"
        },
        {
          "id": "line-4",
          "hans": "放冰蜍飞到，丝丝窗隙。",
          "hant": "放冰蜍飛到，絲絲窗隙。"
        },
        {
          "id": "line-5",
          "hans": "琼瑰暗泣。",
          "hant": "瓊瑰暗泣。"
        },
        {
          "id": "line-6",
          "hans": "念乡关、霜芜似织。",
          "hant": "念鄉關、霜蕪似織。"
        },
        {
          "id": "line-7",
          "hans": "漫将身、化鹤归来，忘却旧游端的。",
          "hant": "漫將身、化鶴歸來，忘卻舊遊端的。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-8",
          "hans": "欢极。",
          "hant": "歡極。"
        },
        {
          "id": "line-9",
          "hans": "蓬壶蕖浸，花院梨溶，醉连春夕。",
          "hant": "蓬壺蕖浸，花院梨溶，醉連春夕。"
        },
        {
          "id": "line-10",
          "hans": "柯云罢弈。",
          "hant": "柯雲罷弈。"
        },
        {
          "id": "line-11",
          "hans": "樱桃在，梦难觅。",
          "hant": "櫻桃在，夢難覓。"
        },
        {
          "id": "line-12",
          "hans": "劝清光，乍可幽窗相伴，休照红楼夜笛。",
          "hant": "勸清光，乍可幽窗相伴，休照紅樓夜笛。"
        },
        {
          "id": "line-13",
          "hans": "怕人间、换谱伊凉，素娥未识。",
          "hant": "怕人間、換譜伊涼，素娥未識。"
        }
      ]
    }
  ],
