  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "渺空烟四远，是何年、青天坠长星。",
          "hant": "渺空煙四遠，是何年、青天墜長星。"
        },
        {
          "id": "line-2",
          "hans": "幻苍崖云树，名娃金屋，残霸宫城。",
          "hant": "幻蒼崖雲樹，名娃金屋，殘霸宮城。"
        },
        {
          "id": "line-3",
          "hans": "箭径酸风射眼，腻水染花腥。",
          "hant": "箭徑酸風射眼，膩水染花腥。"
        },
        {
          "id": "line-4",
          "hans": "时靸双鸳响，廊叶秋声。",
          "hant": "時靸雙鴛響，廊葉秋聲。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "宫里吴王沈醉，倩五湖倦客，独钓醒醒。",
          "hant": "宮裏吳王沈醉，倩五湖倦客，獨釣醒醒。"
        },
        {
          "id": "line-6",
          "hans": "问苍波无语，华发奈山青。",
          "hant": "問蒼波無語，華髮奈山青。"
        },
        {
          "id": "line-7",
          "hans": "水涵空、阑干高处，送乱鸦、斜日落渔汀。",
          "hant": "水涵空、闌干高處，送亂鴉、斜日落漁汀。"
        },
        {
          "id": "line-8",
          "hans": "连呼酒，上琴台去，秋与云平。",
          "hant": "連呼酒，上琴臺去，秋與雲平。"
        }
      ]
    }
  ],
