        {
          "id": "line-1",
          "hans": "绿芜墙绕青苔院。",
          "hant": "綠蕪牆繞青苔院。"
        },
        {
          "id": "line-2",
          "hans": "中庭日淡芭蕉卷。",
          "hant": "中庭日淡芭蕉卷。"
        },
        {
          "id": "line-3",
          "hans": "蝴蝶上阶飞。",
          "hant": "蝴蝶上階飛。"
        },
        {
          "id": "line-4",
          "hans": "烘帘自在垂。",
          "hant": "烘簾自在垂。"
        },
        {
          "id": "line-5",
          "hans": "玉钩双语燕。",
          "hant": "玉鉤雙語燕。"
        },
        {
          "id": "line-6",
          "hans": "宝甃杨花转。",
          "hant": "寶甃楊花轉。"
        },
        {
          "id": "line-7",
          "hans": "几处簸钱声。",
          "hant": "幾處簸錢聲。"
        },
        {
          "id": "line-8",
          "hans": "绿窗春睡轻。",
          "hant": "綠窗春睡輕。"
        }
