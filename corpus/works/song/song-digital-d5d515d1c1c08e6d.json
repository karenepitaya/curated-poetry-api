  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "秋千院落重帘暮。",
          "hant": "鞦韆院落重簾暮。"
        },
        {
          "id": "line-2",
          "hans": "彩笔闲来题绣户。",
          "hant": "彩筆閒來題繡戶。"
        },
        {
          "id": "line-3",
          "hans": "墙头丹杏雨馀花，门外绿杨风後絮。",
          "hant": "牆頭丹杏雨餘花，門外綠楊風後絮。"
        },
        {
          "id": "line-4",
          "hans": "朝云信断知何处。",
          "hant": "朝雲信斷知何處。"
        },
        {
          "id": "line-5",
          "hans": "应作襄王春梦去。",
          "hant": "應作襄王春夢去。"
        },
        {
          "id": "line-6",
          "hans": "紫骝认得旧游踪，嘶过画桥东畔路。",
          "hant": "紫騮認得舊遊蹤，嘶過畫橋東畔路。"
        }
      ]
    }
  ],
