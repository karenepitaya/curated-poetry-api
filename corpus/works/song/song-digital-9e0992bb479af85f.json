  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "梦後楼台高锁，酒醒帘幕低垂。",
          "hant": "夢後樓臺高鎖，酒醒簾幕低垂。"
        },
        {
          "id": "line-2",
          "hans": "去年春恨却来时。",
          "hant": "去年春恨卻來時。"
        },
        {
          "id": "line-3",
          "hans": "落花人独立，微雨燕双飞。",
          "hant": "落花人獨立，微雨燕雙飛。"
        },
        {
          "id": "line-4",
          "hans": "记得小苹初见，两重心字罗衣。",
          "hant": "記得小蘋初見，兩重心字羅衣。"
        },
        {
          "id": "line-5",
          "hans": "琵琶弦上说相思。",
          "hant": "琵琶弦上說相思。"
        },
        {
          "id": "line-6",
          "hans": "当时明月在，曾照彩云归。",
          "hant": "當時明月在，曾照彩雲歸。"
        }
      ]
    }
  ],
