      "lines": [
        {
          "id": "line-1",
          "hans": "一向年光有限身。",
          "hant": "一向年光有限身。"
        },
        {
          "id": "line-2",
          "hans": "等闲离别易消魂。",
          "hant": "等閒離別易消魂。"
        },
        {
          "id": "line-3",
          "hans": "酒筵歌席莫辞频。",
          "hant": "酒筵歌席莫辭頻。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "满目山河空念远，落花风雨更伤春。",
          "hant": "滿目山河空念遠，落花風雨更傷春。"
        },
        {
          "id": "line-5",
          "hans": "不如怜取眼前人。",
          "hant": "不如憐取眼前人。"
        }
      ]
    }
  ],
