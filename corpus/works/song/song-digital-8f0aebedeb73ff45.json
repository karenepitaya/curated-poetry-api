      "lines": [
        {
          "id": "line-1",
          "hans": "绿杨芳草长亭路。",
          "hant": "綠楊芳草長亭路。"
        },
        {
          "id": "line-2",
          "hans": "年少抛人容易去。",
          "hant": "年少拋人容易去。"
        },
        {
          "id": "line-3",
          "hans": "楼头残梦五更钟，花底离情三月雨。",
          "hant": "樓頭殘夢五更鐘，花底離情三月雨。"
        },
        {
          "id": "line-4",
          "hans": "无情不似多情苦。",
          "hant": "無情不似多情苦。"
        },
        {
          "id": "line-5",
          "hans": "一寸还成千万缕。",
          "hant": "一寸還成千萬縷。"
        },
        {
          "id": "line-6",
          "hans": "天涯地角有穷时，只有相思无尽处。",
          "hant": "天涯地角有窮時，只有相思無盡處。"
        }
      ]
    }
  ],
