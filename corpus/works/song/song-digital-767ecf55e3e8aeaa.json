  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "别馆寒砧，孤城画角。",
          "hant": "別館寒砧，孤城畫角。"
        },
        {
          "id": "line-2",
          "hans": "一派秋声入寥廓。",
          "hant": "一派秋聲入寥廓。"
        },
        {
          "id": "line-3",
          "hans": "东归燕从海上去，南来雁向沙头落。",
          "hant": "東歸燕從海上去，南來雁向沙頭落。"
        },
        {
          "id": "line-4",
          "hans": "楚台风，庾楼月，宛如昨。",
          "hant": "楚颱風，庾樓月，宛如昨。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "无奈被些名利缚。",
          "hant": "無奈被些名利縛。"
        },
        {
          "id": "line-6",
          "hans": "无奈被他情担阁。",
          "hant": "無奈被他情擔閣。"
        },
        {
          "id": "line-7",
          "hans": "可惜风流总闲却。",
          "hant": "可惜風流總閒卻。"
        },
        {
          "id": "line-8",
          "hans": "当初漫留华表语，而今误我秦楼约。",
          "hant": "當初漫留華表語，而今誤我秦樓約。"
        },
        {
          "id": "line-9",
          "hans": "梦阑时，酒醒後，思量著。",
          "hant": "夢闌時，酒醒後，思量著。"
        }
      ]
    }
  ],
