  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "月波疑滴。",
          "hant": "月波疑滴。"
        },
        {
          "id": "line-2",
          "hans": "望玉壶天近，了无尘隔。",
          "hant": "望玉壺天近，了無塵隔。"
        },
        {
          "id": "line-3",
          "hans": "翠眼圈花，冰丝织练，黄道宝光相直。",
          "hant": "翠眼圈花，冰絲織練，黃道寶光相直。"
        },
        {
          "id": "line-4",
          "hans": "自怜诗酒瘦，难应接、许多春色。",
          "hant": "自憐詩酒瘦，難應接、許多春色。"
        },
        {
          "id": "line-5",
          "hans": "最无赖，是随香趁烛，曾伴狂客。",
          "hant": "最無賴，是隨香趁燭，曾伴狂客。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-6",
          "hans": "踪迹。",
          "hant": "蹤跡。"
        },
        {
          "id": "line-7",
          "hans": "谩记忆。",
          "hant": "謾記憶。"
        },
        {
          "id": "line-8",
          "hans": "老了杜郎，忍听东风笛。",
          "hant": "老了杜郎，忍聽東風笛。"
        },
        {
          "id": "line-9",
          "hans": "柳院灯疏，梅厅雪在，谁与细倾春碧。",
          "hant": "柳院燈疏，梅廳雪在，誰與細傾春碧。"
        },
        {
          "id": "line-10",
          "hans": "旧情拘未定，犹自学、当年游历。",
          "hant": "舊情拘未定，猶自學、當年遊歷。"
        },
        {
          "id": "line-11",
          "hans": "怕万一，误玉人、夜寒帘隙。",
          "hant": "怕萬一，誤玉人、夜寒簾隙。"
        }
      ]
    }
  ],
