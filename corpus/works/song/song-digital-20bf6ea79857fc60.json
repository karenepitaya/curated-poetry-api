      "lines": [
        {
          "id": "line-1",
          "hans": "一曲新词酒一杯。",
          "hant": "一曲新詞酒一杯。"
        },
        {
          "id": "line-2",
          "hans": "去年天气旧亭台。",
          "hant": "去年天氣舊亭臺。"
        },
        {
          "id": "line-3",
          "hans": "夕阳西下几时回。",
          "hant": "夕陽西下幾時回。"
        },
        {
          "id": "line-4",
          "hans": "无可奈何花落去，似曾相识燕归来。",
          "hant": "無可奈何花落去，似曾相識燕歸來。"
        },
        {
          "id": "line-5",
          "hans": "小园香径独徘徊。",
          "hant": "小園香徑獨徘徊。"
        }
      ]
    }
  ],
