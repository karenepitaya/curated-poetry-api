  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "春风只在园西畔。",
          "hant": "春風只在園西畔。"
        },
        {
          "id": "line-2",
          "hans": "荠菜花繁胡蝶乱。",
          "hant": "薺菜花繁胡蝶亂。"
        },
        {
          "id": "line-3",
          "hans": "冰池晴绿照还空，香径落红吹已断。",
          "hant": "冰池晴綠照還空，香徑落紅吹已斷。"
        },
        {
          "id": "line-4",
          "hans": "意长翻恨游丝短。",
          "hant": "意長翻恨遊絲短。"
        },
        {
          "id": "line-5",
          "hans": "尽日相思罗带缓。",
          "hant": "盡日相思羅帶緩。"
        },
        {
          "id": "line-6",
          "hans": "宝奁明月不欺人，明日归来君试看。",
          "hant": "寶奩明月不欺人，明日歸來君試看。"
        }
      ]
    }
  ],
