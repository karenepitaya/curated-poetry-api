      "lines": [
        {
          "id": "line-1",
          "hans": "长安古道马迟迟。",
          "hant": "長安古道馬遲遲。"
        },
        {
          "id": "line-2",
          "hans": "高柳乱蝉栖。",
          "hant": "高柳亂蟬棲。"
        },
        {
          "id": "line-3",
          "hans": "夕阳岛外，秋风原上，目断四天垂。",
          "hant": "夕陽島外，秋風原上，目斷四天垂。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "归云一去无踪迹，何处是前期。",
          "hant": "歸雲一去無蹤跡，何處是前期。"
        },
        {
          "id": "line-5",
          "hans": "狎兴生疏，酒徒萧索，不似去年时。",
          "hant": "狎興生疏，酒徒蕭索，不似去年時。"
        }
      ]
    }
  ],
