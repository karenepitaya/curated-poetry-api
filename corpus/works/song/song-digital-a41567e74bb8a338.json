  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "万里孤云，清游渐远，故人何处。",
          "hant": "萬里孤雲，清遊漸遠，故人何處。"
        },
        {
          "id": "line-2",
          "hans": "寒窗梦里，犹记经行旧时路。",
          "hant": "寒窗夢裏，猶記經行舊時路。"
        },
        {
          "id": "line-3",
          "hans": "连昌约略无多柳，第一是、难听夜雨。",
          "hant": "連昌約略無多柳，第一是、難聽夜雨。"
        },
        {
          "id": "line-4",
          "hans": "谩惊回凄悄，相看烛影，拥衾谁语。",
          "hant": "謾驚回悽悄，相看燭影，擁衾誰語。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "张绪。",
          "hant": "張緒。"
        },
        {
          "id": "line-6",
          "hans": "归何暮。",
          "hant": "歸何暮。"
        },
        {
          "id": "line-7",
          "hans": "半零落，依依断桥鸥鹭。",
          "hant": "半零落，依依斷橋鷗鷺。"
        },
        {
          "id": "line-8",
          "hans": "天涯倦旅。",
          "hant": "天涯倦旅。"
        },
        {
          "id": "line-9",
          "hans": "此时心事良苦。",
          "hant": "此時心事良苦。"
        },
        {
          "id": "line-10",
          "hans": "只愁重洒西州泪，问杜曲、人家在否。",
          "hant": "只愁重灑西州淚，問杜曲、人家在否。"
        },
        {
          "id": "line-11",
          "hans": "恐翠袖、正天寒，犹倚梅花那树。",
          "hant": "恐翠袖、正天寒，猶倚梅花那樹。"
        }
      ]
    }
  ],
