  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "留人不住。",
          "hant": "留人不住。"
        },
        {
          "id": "line-2",
          "hans": "醉解兰舟去。",
          "hant": "醉解蘭舟去。"
        },
        {
          "id": "line-3",
          "hans": "一棹碧涛春水路。",
          "hant": "一棹碧濤春水路。"
        },
        {
          "id": "line-4",
          "hans": "过尽晓莺啼处。",
          "hant": "過盡曉鶯啼處。"
        },
        {
          "id": "line-5",
          "hans": "渡头杨柳青青。",
          "hant": "渡頭楊柳青青。"
        },
        {
          "id": "line-6",
          "hans": "枝枝叶叶离情。",
          "hant": "枝枝葉葉離情。"
        },
        {
          "id": "line-7",
          "hans": "此後锦书休寄，画楼云雨无凭。",
          "hant": "此後錦書休寄，畫樓雲雨無憑。"
        }
      ]
    }
  ],
