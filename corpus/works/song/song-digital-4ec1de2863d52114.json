      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "画屏天畔，梦回依约，十洲云水。",
          "hant": "畫屏天畔，夢迴依約，十洲雲水。"
        },
        {
          "id": "line-2",
          "hans": "手拈红笺寄人书，写无限、伤春事。",
          "hant": "手拈紅箋寄人書，寫無限、傷春事。"
        },
        {
          "id": "line-3",
          "hans": "别浦高楼曾漫倚。",
          "hant": "別浦高樓曾漫倚。"
        },
        {
          "id": "line-4",
          "hans": "对江南千里。",
          "hant": "對江南千里。"
        },
        {
          "id": "line-5",
          "hans": "楼下分流水声中，有当日、凭高泪。",
          "hant": "樓下分流水聲中，有當日、憑高淚。"
        }
      ]
    }
  ],
