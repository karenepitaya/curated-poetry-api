  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "采幽香，巡古苑，竹冷翠微路。",
          "hant": "採幽香，巡古苑，竹冷翠微路。"
        },
        {
          "id": "line-2",
          "hans": "斗草溪根，沙印小莲步。",
          "hant": "鬥草溪根，沙印小蓮步。"
        },
        {
          "id": "line-3",
          "hans": "自怜两鬓清霜，一年寒食，又身在、云山深处。",
          "hant": "自憐兩鬢清霜，一年寒食，又身在、雲山深處。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "昼闲度。",
          "hant": "晝閒度。"
        },
        {
          "id": "line-5",
          "hans": "因甚天也悭春，轻阴便成雨。",
          "hant": "因甚天也慳春，輕陰便成雨。"
        },
        {
          "id": "line-6",
          "hans": "绿暗长亭，归梦趁风絮。",
          "hant": "綠暗長亭，歸夢趁風絮。"
        },
        {
          "id": "line-7",
          "hans": "有情花影阑干，莺声门径，解留我、霎时凝伫。",
          "hant": "有情花影闌干，鶯聲門徑，解留我、霎時凝佇。"
        }
      ]
    }
  ],
