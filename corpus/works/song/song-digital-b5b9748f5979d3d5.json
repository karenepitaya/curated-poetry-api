      "lines": [
        {
          "id": "line-1",
          "hans": "东风又作无情计。",
          "hant": "東風又作無情計。"
        },
        {
          "id": "line-2",
          "hans": "艳粉娇红吹满地。",
          "hant": "豔粉嬌紅吹滿地。"
        },
        {
          "id": "line-3",
          "hans": "碧楼帘影不遮愁，还似去年今日意。",
          "hant": "碧樓簾影不遮愁，還似去年今日意。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "谁知错管春残事。",
          "hant": "誰知錯管春殘事。"
        },
        {
          "id": "line-5",
          "hans": "到处登临曾费泪。",
          "hant": "到處登臨曾費淚。"
        },
        {
          "id": "line-6",
          "hans": "此时金盏直须深，看尽落花能几醉。",
          "hant": "此時金盞直須深，看盡落花能幾醉。"
        }
      ]
    }
  ],
