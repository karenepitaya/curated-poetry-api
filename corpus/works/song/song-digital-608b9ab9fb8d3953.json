  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "艳真多态。",
          "hant": "豔真多態。"
        },
        {
          "id": "line-2",
          "hans": "更的的，频回眄睐。",
          "hant": "更的的，頻回眄睞。"
        },
        {
          "id": "line-3",
          "hans": "便认得、琴心相许，与写宜男双带。",
          "hant": "便認得、琴心相許，與寫宜男雙帶。"
        },
        {
          "id": "line-4",
          "hans": "记画堂、斜月朦胧，轻颦微笑娇无奈。",
          "hant": "記畫堂、斜月朦朧，輕顰微笑嬌無奈。"
        },
        {
          "id": "line-5",
          "hans": "便翡翠屏开，芙蓉帐掩，与把香罗偷解。",
          "hant": "便翡翠屏開，芙蓉帳掩，與把香羅偷解。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-6",
          "hans": "自过了收灯後，都不见、踏青挑菜。",
          "hant": "自過了收燈後，都不見、踏青挑菜。"
        },
        {
          "id": "line-7",
          "hans": "几回凭双燕，丁宁深意，往来翻恨重帘碍。",
          "hant": "幾回憑雙燕，丁寧深意，往來翻恨重簾礙。"
        },
        {
          "id": "line-8",
          "hans": "约何时再。",
          "hant": "約何時再。"
        },
        {
          "id": "line-9",
          "hans": "正春浓酒暖，人闲昼永无聊赖。",
          "hant": "正春濃酒暖，人閒晝永無聊賴。"
        },
        {
          "id": "line-10",
          "hans": "厌厌睡起，犹有花梢日在。",
          "hant": "厭厭睡起，猶有花梢日在。"
        }
      ]
    }
  ],
