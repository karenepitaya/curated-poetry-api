  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "明月几时有，把酒问青天。",
          "hant": "明月幾時有，把酒問青天。"
        },
        {
          "id": "line-2",
          "hans": "不知天上宫阙，今夕是何年。",
          "hant": "不知天上宮闕，今夕是何年。"
        },
        {
          "id": "line-3",
          "hans": "我欲乘风归去，又恐琼楼玉宇，高处不胜寒。",
          "hant": "我欲乘風歸去，又恐瓊樓玉宇，高處不勝寒。"
        },
        {
          "id": "line-4",
          "hans": "起舞弄清影，何似在人间。",
          "hant": "起舞弄清影，何似在人間。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "转朱阁，低绮户，照无眠。",
          "hant": "轉朱閣，低綺戶，照無眠。"
        },
        {
          "id": "line-6",
          "hans": "不应有恨，何事长向别时圆。",
          "hant": "不應有恨，何事長向別時圓。"
        },
        {
          "id": "line-7",
          "hans": "人有悲欢离合，月有阴晴圆缺，此事古难全。",
          "hant": "人有悲歡離合，月有陰晴圓缺，此事古難全。"
        },
        {
          "id": "line-8",
          "hans": "但愿人长久，千里共婵娟。",
          "hant": "但願人長久，千里共嬋娟。"
        }
      ]
    }
  ],
