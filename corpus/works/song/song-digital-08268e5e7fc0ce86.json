      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "卷尽愁云，素娥临夜新梳洗。",
          "hant": "卷盡愁雲，素娥臨夜新梳洗。"
        },
        {
          "id": "line-2",
          "hans": "暗尘不起。",
          "hant": "暗塵不起。"
        },
        {
          "id": "line-3",
          "hans": "酥润凌波地。",
          "hant": "酥潤凌波地。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "辇路重来，仿佛灯前事。",
          "hant": "輦路重來，彷彿燈前事。"
        },
        {
          "id": "line-5",
          "hans": "情如水。",
          "hant": "情如水。"
        },
        {
          "id": "line-6",
          "hans": "小楼熏被。",
          "hant": "小樓燻被。"
        },
        {
          "id": "line-7",
          "hans": "春梦笙歌里。",
          "hant": "春夢笙歌裏。"
        }
      ]
    }
  ],
