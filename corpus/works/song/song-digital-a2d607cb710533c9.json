  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "芳草碧色，萋萋遍南陌。",
          "hant": "芳草碧色，萋萋遍南陌。"
        },
        {
          "id": "line-2",
          "hans": "暖絮乱红，也知人、春愁无力。",
          "hant": "暖絮亂紅，也知人、春愁無力。"
        },
        {
          "id": "line-3",
          "hans": "忆得盈盈拾翠侣，共携赏、凤城寒食。",
          "hant": "憶得盈盈拾翠侶，共攜賞、鳳城寒食。"
        },
        {
          "id": "line-4",
          "hans": "到今来，海角逢春，天涯为客。",
          "hant": "到今來，海角逢春，天涯爲客。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "愁旋释。",
          "hant": "愁旋釋。"
        },
        {
          "id": "line-6",
          "hans": "还似织。",
          "hant": "還似織。"
        },
        {
          "id": "line-7",
          "hans": "泪暗拭。",
          "hant": "淚暗拭。"
        },
        {
          "id": "line-8",
          "hans": "又偷滴。",
          "hant": "又偷滴。"
        },
        {
          "id": "line-9",
          "hans": "谩伫立、遍倚危阑，尽黄昏，也只是、暮云凝碧。",
          "hant": "謾佇立、遍倚危闌，盡黃昏，也只是、暮雲凝碧。"
        },
        {
          "id": "line-10",
          "hans": "拼则而已今拼了，忘则怎生便忘得。",
          "hant": "拼則而已今拼了，忘則怎生便忘得。"
        },
        {
          "id": "line-11",
          "hans": "又还问鳞鸿，试重寻消息。",
          "hant": "又還問鱗鴻，試重尋消息。"
        }
      ]
    }
  ],
