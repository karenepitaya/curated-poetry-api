      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "红笺小字。",
          "hant": "紅箋小字。"
        },
        {
          "id": "line-2",
          "hans": "说尽平生意。",
          "hant": "說盡平生意。"
        },
        {
          "id": "line-3",
          "hans": "鸿雁在云鱼在水。",
          "hant": "鴻雁在雲魚在水。"
        },
        {
          "id": "line-4",
          "hans": "惆怅此情难寄。",
          "hant": "惆悵此情難寄。"
        },
        {
          "id": "line-5",
          "hans": "斜阳独倚西楼。",
          "hant": "斜陽獨倚西樓。"
        },
        {
          "id": "line-6",
          "hans": "遥山恰对帘钩。",
          "hant": "遙山恰對簾鉤。"
        },
        {
          "id": "line-7",
          "hans": "人面不知何处，绿波依旧东流。",
          "hant": "人面不知何處，綠波依舊東流。"
        }
      ]
    }
  ],
