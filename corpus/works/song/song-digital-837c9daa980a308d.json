      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "芦叶满汀洲。",
          "hant": "蘆葉滿汀洲。"
        },
        {
          "id": "line-2",
          "hans": "塞沙带浅流。",
          "hant": "塞沙帶淺流。"
        },
        {
          "id": "line-3",
          "hans": "二十年、重过南楼。",
          "hant": "二十年、重過南樓。"
        },
        {
          "id": "line-4",
          "hans": "柳下系舟犹未稳，能几日、又中秋。",
          "hant": "柳下系舟猶未穩，能幾日、又中秋。"
        },
        {
          "id": "line-5",
          "hans": "黄鹤断矶头。",
          "hant": "黃鶴斷磯頭。"
        },
        {
          "id": "line-6",
          "hans": "故人今不在。",
          "hant": "故人今不在。"
        },
        {
          "id": "line-7",
          "hans": "旧江山，浑是新愁。",
          "hant": "舊江山，渾是新愁。"
        },
        {
          "id": "line-8",
          "hans": "欲买桂花同载酒，终不似、少年游。",
          "hant": "欲買桂花同載酒，終不似、少年遊。"
        }
      ]
    }
  ],
