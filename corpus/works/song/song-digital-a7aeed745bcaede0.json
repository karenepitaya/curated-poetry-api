      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "何处合成愁。",
          "hant": "何處合成愁。"
        },
        {
          "id": "line-2",
          "hans": "离人心上秋。",
          "hant": "離人心上秋。"
        },
        {
          "id": "line-3",
          "hans": "纵芭蕉、不雨也飕飕。",
          "hant": "縱芭蕉、不雨也颼颼。"
        },
        {
          "id": "line-4",
          "hans": "都道晚凉天气好，有明月、怕登楼。",
          "hant": "都道晚涼天氣好，有明月、怕登樓。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "年事梦中休。",
          "hant": "年事夢中休。"
        },
        {
          "id": "line-6",
          "hans": "花空烟水流。",
          "hant": "花空煙水流。"
        },
        {
          "id": "line-7",
          "hans": "燕辞归、客尚淹留。",
          "hant": "燕辭歸、客尚淹留。"
        },
        {
          "id": "line-8",
          "hans": "垂柳不萦裙带住，漫长是、系行舟。",
          "hant": "垂柳不縈裙帶住，漫長是、系行舟。"
        }
      ]
    }
  ],
