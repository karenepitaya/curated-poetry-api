      "lines": [
        {
          "id": "line-1",
          "hans": "枕簟溪堂冷欲秋。",
          "hant": "枕簟溪堂冷欲秋。"
        },
        {
          "id": "line-2",
          "hans": "断云依水晚来收。",
          "hant": "斷雲依水晚來收。"
        },
        {
          "id": "line-3",
          "hans": "红莲相倚浑如醉，白鸟无言定自愁。",
          "hant": "紅蓮相倚渾如醉，白鳥無言定自愁。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "书咄咄，且休休。",
          "hant": "書咄咄，且休休。"
        },
        {
          "id": "line-5",
          "hans": "一丘一壑也风流。",
          "hant": "一丘一壑也風流。"
        },
        {
          "id": "line-6",
          "hans": "不知筋力衰多少，但觉新来懒上楼。",
          "hant": "不知筋力衰多少，但覺新來懶上樓。"
        }
      ]
    }
  ],
