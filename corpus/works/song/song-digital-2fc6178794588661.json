  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "三年枕上吴中路。",
          "hant": "三年枕上吳中路。"
        },
        {
          "id": "line-2",
          "hans": "遣黄耳、随君去。",
          "hant": "遣黃耳、隨君去。"
        },
        {
          "id": "line-3",
          "hans": "若到松江呼小渡。",
          "hant": "若到松江呼小渡。"
        },
        {
          "id": "line-4",
          "hans": "莫惊鸥鹭，四桥尽是，老子经行处。",
          "hant": "莫驚鷗鷺，四橋盡是，老子經行處。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "辋川图上看春暮。",
          "hant": "輞川圖上看春暮。"
        },
        {
          "id": "line-6",
          "hans": "常记高人右丞句。",
          "hant": "常記高人右丞句。"
        },
        {
          "id": "line-7",
          "hans": "作个归期天已许。",
          "hant": "作個歸期天已許。"
        },
        {
          "id": "line-8",
          "hans": "春衫犹是，小蛮针线，曾湿西湖雨。",
          "hant": "春衫猶是，小蠻針線，曾溼西湖雨。"
        }
      ]
    }
  ],
