  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "晓光催角。",
          "hant": "曉光催角。"
        },
        {
          "id": "line-2",
          "hans": "听宿鸟未惊，邻鸡先觉。",
          "hant": "聽宿鳥未驚，鄰雞先覺。"
        },
        {
          "id": "line-3",
          "hans": "迤逦烟村，马嘶人起，残月尚穿林薄。",
          "hant": "迤邐煙村，馬嘶人起，殘月尚穿林薄。"
        },
        {
          "id": "line-4",
          "hans": "泪痕带霜微凝，酒力冲寒犹弱。",
          "hant": "淚痕帶霜微凝，酒力衝寒猶弱。"
        },
        {
          "id": "line-5",
          "hans": "叹倦客、悄不禁，重染风尘京洛。",
          "hant": "嘆倦客、悄不禁，重染風塵京洛。"
        },
        {
          "id": "line-6",
          "hans": "追念，人别後，心事万重，难觅孤鸿托。",
          "hant": "追念，人別後，心事萬重，難覓孤鴻託。"
        },
        {
          "id": "line-7",
          "hans": "翠幌娇深，曲屏香暖，争念岁寒飘泊。",
          "hant": "翠幌嬌深，曲屏香暖，爭念歲寒飄泊。"
        },
        {
          "id": "line-8",
          "hans": "怨月恨花烦恼，不是不曾经著。",
          "hant": "怨月恨花煩惱，不是不曾經著。"
        },
        {
          "id": "line-9",
          "hans": "这情味，望一成消减，新来还恶。",
          "hant": "這情味，望一成消減，新來還惡。"
        }
      ]
    }
  ],
