      "lines": [
        {
          "id": "line-1",
          "hans": "湘天风雨破寒初。",
          "hant": "湘天風雨破寒初。"
        },
        {
          "id": "line-2",
          "hans": "深沈庭院虚。",
          "hant": "深沈庭院虛。"
        },
        {
          "id": "line-3",
          "hans": "丽谯吹罢《小单于》。",
          "hant": "麗譙吹罷《小單于》。"
        },
        {
          "id": "line-4",
          "hans": "迢迢清夜徂。",
          "hant": "迢迢清夜徂。"
        },
        {
          "id": "line-5",
          "hans": "乡梦断，旅魂孤。",
          "hant": "鄉夢斷，旅魂孤。"
        },
        {
          "id": "line-6",
          "hans": "峥嵘岁又除。",
          "hant": "崢嶸歲又除。"
        },
        {
          "id": "line-7",
          "hans": "衡阳犹有雁传书。",
          "hant": "衡陽猶有雁傳書。"
        },
        {
          "id": "line-8",
          "hans": "郴阳和雁无。",
          "hant": "郴陽和雁無。"
        }
      ]
    }
