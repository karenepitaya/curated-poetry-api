      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "燕燕轻盈，莺莺娇软。",
          "hant": "燕燕輕盈，鶯鶯嬌軟。"
        },
        {
          "id": "line-2",
          "hans": "分明又向华胥见。",
          "hant": "分明又向華胥見。"
        },
        {
          "id": "line-3",
          "hans": "夜长争得薄情知，春初早被相思染。",
          "hant": "夜長爭得薄情知，春初早被相思染。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "别後书辞，别时针线。",
          "hant": "別後書辭，別時針線。"
        },
        {
          "id": "line-5",
          "hans": "离魂暗逐郎行远。",
          "hant": "離魂暗逐郎行遠。"
        },
        {
          "id": "line-6",
          "hans": "淮南皓月冷千山，冥冥归去无人管。",
          "hant": "淮南皓月冷千山，冥冥歸去無人管。"
        }
      ]
    }
  ],
