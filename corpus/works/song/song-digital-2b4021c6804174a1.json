  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "千古江山，英雄无觅，孙仲谋处。",
          "hant": "千古江山，英雄無覓，孫仲謀處。"
        },
        {
          "id": "line-2",
          "hans": "舞榭歌台，风流总被，雨打风吹去。",
          "hant": "舞榭歌臺，風流總被，雨打風吹去。"
        },
        {
          "id": "line-3",
          "hans": "斜阳草树，寻常巷陌，人道寄奴曾住。",
          "hant": "斜陽草樹，尋常巷陌，人道寄奴曾住。"
        },
        {
          "id": "line-4",
          "hans": "想当年，金戈铁马，气吞万里如虎。",
          "hant": "想當年，金戈鐵馬，氣吞萬里如虎。"
        },
        {
          "id": "line-5",
          "hans": "元嘉草草，封狼居胥，赢得仓皇北顾。",
          "hant": "元嘉草草，封狼居胥，贏得倉皇北顧。"
        },
        {
          "id": "line-6",
          "hans": "四十三年，望中犹记，烽火扬州路。",
          "hant": "四十三年，望中猶記，烽火揚州路。"
        },
        {
          "id": "line-7",
          "hans": "可堪回首，佛狸祠下，一片神鸦社鼓。",
          "hant": "可堪回首，佛狸祠下，一片神鴉社鼓。"
        },
        {
          "id": "line-8",
          "hans": "凭谁问，廉颇老矣，尚能饭否。",
          "hant": "憑誰問，廉頗老矣，尚能飯否。"
        }
      ]
    }
  ],
