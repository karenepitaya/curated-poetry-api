  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "湛湛长空黑。",
          "hant": "湛湛長空黑。"
        },
        {
          "id": "line-2",
          "hans": "更那堪、斜风细雨，乱愁如织。",
          "hant": "更那堪、斜風細雨，亂愁如織。"
        },
        {
          "id": "line-3",
          "hans": "老眼平生空四海，赖有高楼百尺。",
          "hant": "老眼平生空四海，賴有高樓百尺。"
        },
        {
          "id": "line-4",
          "hans": "看浩荡、千崖秋色。",
          "hant": "看浩蕩、千崖秋色。"
        },
        {
          "id": "line-5",
          "hans": "白发书生神州泪，尽凄凉、不向牛山滴。",
          "hant": "白髮書生神州淚，盡淒涼、不向牛山滴。"
        },
        {
          "id": "line-6",
          "hans": "追往事，去无迹。",
          "hant": "追往事，去無跡。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-7",
          "hans": "少年自负凌云笔。",
          "hant": "少年自負凌雲筆。"
        },
        {
          "id": "line-8",
          "hans": "到而今、春华落尽，满怀萧瑟。",
          "hant": "到而今、春華落盡，滿懷蕭瑟。"
        },
        {
          "id": "line-9",
          "hans": "常恨世人新意少，爱说南朝狂客。",
          "hant": "常恨世人新意少，愛說南朝狂客。"
        },
        {
          "id": "line-10",
          "hans": "把破帽、年年拈出。",
          "hant": "把破帽、年年拈出。"
        },
        {
          "id": "line-11",
          "hans": "若对黄花孤负酒，怕黄花、也笑人岑寂。",
          "hant": "若對黃花孤負酒，怕黃花、也笑人岑寂。"
        },
        {
          "id": "line-12",
          "hans": "鸿北去，日西匿。",
          "hant": "鴻北去，日西匿。"
        }
      ]
    }
  ],
