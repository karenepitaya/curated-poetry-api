  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "冰肌玉骨，自清凉无汗。",
          "hant": "冰肌玉骨，自清涼無汗。"
        },
        {
          "id": "line-2",
          "hans": "水殿风来暗香满。",
          "hant": "水殿風來暗香滿。"
        },
        {
          "id": "line-3",
          "hans": "绣帘开、一点明月窥人，人未寝、枕钗横鬓乱。",
          "hant": "繡簾開、一點明月窺人，人未寢、枕釵橫鬢亂。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "起来携素手，庭户无声，时见疏星渡河汉。",
          "hant": "起來攜素手，庭戶無聲，時見疏星渡河漢。"
        },
        {
          "id": "line-5",
          "hans": "试问夜如何，夜已三更，金波淡、玉绳低转。",
          "hant": "試問夜如何，夜已三更，金波淡、玉繩低轉。"
        },
        {
          "id": "line-6",
          "hans": "但屈指、西风几时来，又不道、流年暗中偷换。",
          "hant": "但屈指、西風幾時來，又不道、流年暗中偷換。"
        }
      ]
    }
  ],
