      "lines": [
        {
          "id": "line-1",
          "hans": "东城渐觉风光好。",
          "hant": "東城漸覺風光好。"
        },
        {
          "id": "line-2",
          "hans": "皱波纹迎客棹。",
          "hant": "皺波紋迎客棹。"
        },
        {
          "id": "line-3",
          "hans": "绿杨烟外晓寒轻，红杏枝头春意闹。",
          "hant": "綠楊煙外曉寒輕，紅杏枝頭春意鬧。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "浮生长恨欢娱少。",
          "hant": "浮生長恨歡娛少。"
        },
        {
          "id": "line-5",
          "hans": "肯爱千金轻一笑。",
          "hant": "肯愛千金輕一笑。"
        },
        {
          "id": "line-6",
          "hans": "为君持酒劝斜阳，且向花间留晚照。",
          "hant": "爲君持酒勸斜陽，且向花間留晚照。"
        }
      ]
    }
  ],
