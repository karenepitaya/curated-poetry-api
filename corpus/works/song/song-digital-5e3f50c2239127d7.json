  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "情似游丝，人如飞絮。",
          "hant": "情似遊絲，人如飛絮。"
        },
        {
          "id": "line-2",
          "hans": "泪珠阁定空相觑。",
          "hant": "淚珠閣定空相覷。"
        },
        {
          "id": "line-3",
          "hans": "一溪烟柳万丝垂，无因系得兰舟住。",
          "hant": "一溪煙柳萬絲垂，無因系得蘭舟住。"
        },
        {
          "id": "line-4",
          "hans": "雁过斜阳，草迷烟渚。",
          "hant": "雁過斜陽，草迷煙渚。"
        },
        {
          "id": "line-5",
          "hans": "如今已是愁无数。",
          "hant": "如今已是愁無數。"
        },
        {
          "id": "line-6",
          "hans": "明朝且做莫思量，如何过得今宵去。",
          "hant": "明朝且做莫思量，如何過得今宵去。"
        }
      ]
    }
  ],
