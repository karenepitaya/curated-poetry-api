      "lines": [
        {
          "id": "line-1",
          "hans": "忆昔午桥桥上饮，坐中多是豪英。",
          "hant": "憶昔午橋橋上飲，坐中多是豪英。"
        },
        {
          "id": "line-2",
          "hans": "长沟流月去无声。",
          "hant": "長溝流月去無聲。"
        },
        {
          "id": "line-3",
          "hans": "杏花疏影里，吹笛到天明。",
          "hant": "杏花疏影裏，吹笛到天明。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "二十馀年如一梦，此身虽在堪惊。",
          "hant": "二十餘年如一夢，此身雖在堪驚。"
        },
        {
          "id": "line-5",
          "hans": "闲登小阁看新晴。",
          "hant": "閒登小閣看新晴。"
        },
        {
          "id": "line-6",
          "hans": "古今多少事，渔唱起三更。",
          "hant": "古今多少事，漁唱起三更。"
        }
      ]
    }
  ],
