      "lines": [
        {
          "id": "line-1",
          "hans": "关山魂梦长，鱼雁音尘少。",
          "hant": "關山魂夢長，魚雁音塵少。"
        },
        {
          "id": "line-2",
          "hans": "两鬓可怜青，只为相思老。",
          "hant": "兩鬢可憐青，只爲相思老。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-3",
          "hans": "归梦碧纱窗，说与人人道。",
          "hant": "歸夢碧紗窗，說與人人道。"
        },
        {
          "id": "line-4",
          "hans": "真个别离难，不似相逢好。",
          "hant": "真個別離難，不似相逢好。"
        }
      ]
    }
  ],
