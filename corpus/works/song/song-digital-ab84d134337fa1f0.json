  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "卷絮风头寒欲尽。",
          "hant": "卷絮風頭寒欲盡。"
        },
        {
          "id": "line-2",
          "hans": "坠粉飘红，日日香成阵。",
          "hant": "墜粉飄紅，日日香成陣。"
        },
        {
          "id": "line-3",
          "hans": "新酒又添残酒困。",
          "hant": "新酒又添殘酒困。"
        },
        {
          "id": "line-4",
          "hans": "今春不减前春恨。",
          "hant": "今春不減前春恨。"
        },
        {
          "id": "line-5",
          "hans": "蝶去莺飞无处问。",
          "hant": "蝶去鶯飛無處問。"
        },
        {
          "id": "line-6",
          "hans": "隔水高楼，望断双鱼信。",
          "hant": "隔水高樓，望斷雙魚信。"
        },
        {
          "id": "line-7",
          "hans": "恼乱层波横一寸。",
          "hant": "惱亂層波橫一寸。"
        },
        {
          "id": "line-8",
          "hans": "斜阳只与黄昏近。",
          "hant": "斜陽只與黃昏近。"
        }
      ]
    }
  ],
