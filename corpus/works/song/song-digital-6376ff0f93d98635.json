      "lines": [
        {
          "id": "line-1",
          "hans": "留春不住。",
          "hant": "留春不住。"
        },
        {
          "id": "line-2",
          "hans": "费尽莺儿语。",
          "hant": "費盡鶯兒語。"
        },
        {
          "id": "line-3",
          "hans": "满地残红宫锦污。",
          "hant": "滿地殘紅宮錦污。"
        },
        {
          "id": "line-4",
          "hans": "昨夜南园风雨。",
          "hant": "昨夜南園風雨。"
        },
        {
          "id": "line-5",
          "hans": "小怜初上琵琶。",
          "hant": "小憐初上琵琶。"
        },
        {
          "id": "line-6",
          "hans": "晓来思绕天涯。",
          "hant": "曉來思繞天涯。"
        },
        {
          "id": "line-7",
          "hans": "不肯画堂朱户，春风自在梨花。",
          "hant": "不肯畫堂朱戶，春風自在梨花。"
        }
      ]
    }
  ],
