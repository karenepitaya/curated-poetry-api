      "lines": [
        {
          "id": "line-1",
          "hans": "红叶黄花秋意晚，千里念行客。",
          "hant": "紅葉黃花秋意晚，千里念行客。"
        },
        {
          "id": "line-2",
          "hans": "飞云过尽，归鸿无信，何处寄书得。",
          "hant": "飛雲過盡，歸鴻無信，何處寄書得。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-3",
          "hans": "泪弹不尽临窗滴。",
          "hant": "淚彈不盡臨窗滴。"
        },
        {
          "id": "line-4",
          "hans": "就砚旋研墨。",
          "hant": "就硯旋研墨。"
        },
        {
          "id": "line-5",
          "hans": "渐写到别来，此情深处，红笺为无色。",
          "hant": "漸寫到別來，此情深處，紅箋爲無色。"
        }
      ]
    }
  ],
