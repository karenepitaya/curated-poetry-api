      "lines": [
        {
          "id": "line-1",
          "hans": "薄雾浓云愁永昼。",
          "hant": "薄霧濃雲愁永晝。"
        },
        {
          "id": "line-2",
          "hans": "瑞脑消金兽。",
          "hant": "瑞腦消金獸。"
        },
        {
          "id": "line-3",
          "hans": "佳节又重阳，玉枕纱厨，半夜凉初透。",
          "hant": "佳節又重陽，玉枕紗廚，半夜涼初透。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "东篱把洒黄昏後，有暗香盈袖。",
          "hant": "東籬把灑黃昏後，有暗香盈袖。"
        },
        {
          "id": "line-5",
          "hans": "莫道不消魂，帘卷西风，人似黄花瘦。",
          "hant": "莫道不消魂，簾卷西風，人似黃花瘦。"
        }
      ]
    }
  ],
