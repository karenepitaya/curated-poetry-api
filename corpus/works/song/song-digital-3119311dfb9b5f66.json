  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "彩袖殷勤捧玉锺。",
          "hant": "彩袖殷勤捧玉鍾。"
        },
        {
          "id": "line-2",
          "hans": "当年拼却醉颜红。",
          "hant": "當年拼卻醉顏紅。"
        },
        {
          "id": "line-3",
          "hans": "舞低杨柳楼心月，歌尽桃花扇影风。",
          "hant": "舞低楊柳樓心月，歌盡桃花扇影風。"
        },
        {
          "id": "line-4",
          "hans": "从别後，忆相逢。",
          "hant": "從別後，憶相逢。"
        },
        {
          "id": "line-5",
          "hans": "几回魂梦与君同。",
          "hant": "幾回魂夢與君同。"
        },
        {
          "id": "line-6",
          "hans": "今宵剩把银釭照，犹恐相逢是梦中。",
          "hant": "今宵剩把銀釭照，猶恐相逢是夢中。"
        }
      ]
    }
  ],
