      "lines": [
        {
          "id": "line-1",
          "hans": "旧香残粉似当初。",
          "hant": "舊香殘粉似當初。"
        },
        {
          "id": "line-2",
          "hans": "人情恨不如。",
          "hant": "人情恨不如。"
        },
        {
          "id": "line-3",
          "hans": "一春犹有数行书。",
          "hant": "一春猶有數行書。"
        },
        {
          "id": "line-4",
          "hans": "秋来书更疏。",
          "hant": "秋來書更疏。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "衾凤冷，枕鸳孤。",
          "hant": "衾鳳冷，枕鴛孤。"
        },
        {
          "id": "line-6",
          "hans": "愁肠待酒舒。",
          "hant": "愁腸待酒舒。"
        },
        {
          "id": "line-7",
          "hans": "梦魂纵有也成虚。",
          "hant": "夢魂縱有也成虛。"
        },
        {
          "id": "line-8",
          "hans": "那堪和梦无。",
          "hant": "那堪和夢無。"
        }
      ]
    }
  ],
