      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "月皎惊乌栖不定。",
          "hant": "月皎驚烏棲不定。"
        },
        {
          "id": "line-2",
          "hans": "更漏将残，辘，牵金井。",
          "hant": "更漏將殘，轆，牽金井。"
        },
        {
          "id": "line-3",
          "hans": "唤起两眸清炯炯。",
          "hant": "喚起兩眸清炯炯。"
        },
        {
          "id": "line-4",
          "hans": "泪花落枕红棉泠。",
          "hant": "淚花落枕紅棉泠。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "执手霜风吹鬓影。",
          "hant": "執手霜風吹鬢影。"
        },
        {
          "id": "line-6",
          "hans": "去意徊徨，别语愁难听。",
          "hant": "去意徊徨，別語愁難聽。"
        },
        {
          "id": "line-7",
          "hans": "楼上阑干横斗柄。",
          "hant": "樓上闌干橫斗柄。"
        },
        {
          "id": "line-8",
          "hans": "露寒人远鸡相应。",
          "hant": "露寒人遠雞相應。"
        }
      ]
    }
  ],
