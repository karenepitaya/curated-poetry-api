      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "秋阴时晴渐向暝，变一庭凄冷。",
          "hant": "秋陰時晴漸向暝，變一庭淒冷。"
        },
        {
          "id": "line-2",
          "hans": "伫听寒声，云深无雁影。",
          "hant": "佇聽寒聲，雲深無雁影。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-3",
          "hans": "更深人去寂静。",
          "hant": "更深人去寂靜。"
        },
        {
          "id": "line-4",
          "hans": "但照壁、孤灯相映。",
          "hant": "但照壁、孤燈相映。"
        },
        {
          "id": "line-5",
          "hans": "酒已都醒，如何消夜永。",
          "hant": "酒已都醒，如何消夜永。"
        }
      ]
    }
  ],
