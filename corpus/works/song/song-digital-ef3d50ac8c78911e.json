  "title": {
    "hans": "三台·见梨花初带夜月",
    "hant": "三臺·見梨花初帶夜月"
  },
  "author": {
    "name": {
      "hans": "万俟咏",
      "hant": "万俟詠"
    },
    "attributionStatus": "selected-edition"
