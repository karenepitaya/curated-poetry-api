  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "双桨来时，有人似、旧曲桃根桃叶。",
          "hant": "雙槳來時，有人似、舊曲桃根桃葉。"
        },
        {
          "id": "line-2",
          "hans": "歌扇轻约飞花，蛾眉正奇绝。",
          "hant": "歌扇輕約飛花，蛾眉正奇絕。"
        },
        {
          "id": "line-3",
          "hans": "春渐远、汀洲自绿，更添了、几声啼。",
          "hant": "春漸遠、汀洲自綠，更添了、幾聲啼。"
        },
        {
          "id": "line-4",
          "hans": "十里扬州，三生杜牧，前事休说。",
          "hant": "十里揚州，三生杜牧，前事休說。"
        },
        {
          "id": "line-5",
          "hans": "又还是、宫烛分烟，奈愁里、匆匆换时节。",
          "hant": "又還是、宮燭分煙，奈愁裏、匆匆換時節。"
        },
        {
          "id": "line-6",
          "hans": "都把一襟芳思，与空阶榆荚。",
          "hant": "都把一襟芳思，與空階榆莢。"
        },
        {
          "id": "line-7",
          "hans": "千万缕、藏鸦细柳，为玉尊、起舞回雪。",
          "hant": "千萬縷、藏鴉細柳，爲玉尊、起舞迴雪。"
        },
        {
          "id": "line-8",
          "hans": "想见西出阳关，故人初别。",
          "hant": "想見西出陽關，故人初別。"
        }
      ]
    }
  ],
