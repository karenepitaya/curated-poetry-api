      "lines": [
        {
          "id": "line-1",
          "hans": "祖席离歌，长亭别宴。",
          "hant": "祖席離歌，長亭別宴。"
        },
        {
          "id": "line-2",
          "hans": "香尘已隔犹回面。",
          "hant": "香塵已隔猶回面。"
        },
        {
          "id": "line-3",
          "hans": "居人匹马映林嘶，行人去棹依波转。",
          "hant": "居人匹馬映林嘶，行人去棹依波轉。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "画阁魂消，高楼目断。",
          "hant": "畫閣魂消，高樓目斷。"
        },
        {
          "id": "line-5",
          "hans": "斜阳只送平波远。",
          "hant": "斜陽只送平波遠。"
        },
        {
          "id": "line-6",
          "hans": "无穷无尽是离愁，天涯地角寻思遍。",
          "hant": "無窮無盡是離愁，天涯地角尋思遍。"
        }
      ]
    }
  ],
