      "lines": [
        {
          "id": "line-1",
          "hans": "池上红衣伴倚阑。",
          "hant": "池上紅衣伴倚闌。"
        },
        {
          "id": "line-2",
          "hans": "栖鸦常带夕阳还。",
          "hant": "棲鴉常帶夕陽還。"
        },
        {
          "id": "line-3",
          "hans": "殷云度雨疏桐落，明月生凉宝扇闲。",
          "hant": "殷雲度雨疏桐落，明月生涼寶扇閒。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "乡梦窄，水天宽。",
          "hant": "鄉夢窄，水天寬。"
        },
        {
          "id": "line-5",
          "hans": "小窗愁黛澹秋山。",
          "hant": "小窗愁黛澹秋山。"
        },
        {
          "id": "line-6",
          "hans": "吴鸿好为传归信，杨柳阊门屋数间。",
          "hant": "吳鴻好爲傳歸信，楊柳閶門屋數間。"
        }
      ]
    }
  ],
