      "lines": [
        {
          "id": "line-1",
          "hans": "醉别西楼醒不记。",
          "hant": "醉別西樓醒不記。"
        },
        {
          "id": "line-2",
          "hans": "春梦秋云，聚散真容易。",
          "hant": "春夢秋雲，聚散真容易。"
        },
        {
          "id": "line-3",
          "hans": "斜月半窗还少睡。",
          "hant": "斜月半窗還少睡。"
        },
        {
          "id": "line-4",
          "hans": "画屏闲展吴山翠。",
          "hant": "畫屏閒展吳山翠。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "衣上酒痕诗里字。",
          "hant": "衣上酒痕詩裏字。"
        },
        {
          "id": "line-6",
          "hans": "点点行行，总是凄凉意。",
          "hant": "點點行行，總是淒涼意。"
        },
        {
          "id": "line-7",
          "hans": "红烛自怜无好计。",
          "hant": "紅燭自憐無好計。"
        },
        {
          "id": "line-8",
          "hans": "夜寒空替人垂泪。",
          "hant": "夜寒空替人垂淚。"
        }
      ]
    }
  ],
