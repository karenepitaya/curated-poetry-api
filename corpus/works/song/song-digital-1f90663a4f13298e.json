      "lines": [
        {
          "id": "line-1",
          "hans": "年年社日停针线。",
          "hant": "年年社日停針線。"
        },
        {
          "id": "line-2",
          "hans": "怎忍见、双飞燕。",
          "hant": "怎忍見、雙飛燕。"
        },
        {
          "id": "line-3",
          "hans": "今日江城春已半。",
          "hant": "今日江城春已半。"
        },
        {
          "id": "line-4",
          "hans": "一身犹在，乱山深处，寂寞溪桥畔。",
          "hant": "一身猶在，亂山深處，寂寞溪橋畔。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "春衫著破谁针线。",
          "hant": "春衫著破誰針線。"
        },
        {
          "id": "line-6",
          "hans": "点点行行泪痕满。",
          "hant": "點點行行淚痕滿。"
        },
        {
          "id": "line-7",
          "hans": "落日解鞍芳草岸。",
          "hant": "落日解鞍芳草岸。"
        },
        {
          "id": "line-8",
          "hans": "花无人戴，酒无人劝，醉也无人管。",
          "hant": "花無人戴，酒無人勸，醉也無人管。"
        }
      ]
    }
  ],
