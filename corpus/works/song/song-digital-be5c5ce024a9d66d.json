      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "楼阴缺。",
          "hant": "樓陰缺。"
        },
        {
          "id": "line-2",
          "hans": "阑干影卧东厢月。",
          "hant": "闌干影臥東廂月。"
        },
        {
          "id": "line-3",
          "hans": "东厢月。",
          "hant": "東廂月。"
        },
        {
          "id": "line-4",
          "hans": "一天风露，杏花如雪。",
          "hant": "一天風露，杏花如雪。"
        },
        {
          "id": "line-5",
          "hans": "隔烟催漏金虬咽。",
          "hant": "隔煙催漏金虯咽。"
        },
        {
          "id": "line-6",
          "hans": "罗帏暗淡灯花结。",
          "hant": "羅幃暗淡燈花結。"
        },
        {
          "id": "line-7",
          "hans": "灯花结。",
          "hant": "燈花結。"
        },
        {
          "id": "line-8",
          "hans": "片时春梦，江南天阔。",
          "hant": "片時春夢，江南天闊。"
        }
      ]
    }
