      "lines": [
        {
          "id": "line-1",
          "hans": "天边金掌露成霜。",
          "hant": "天邊金掌露成霜。"
        },
        {
          "id": "line-2",
          "hans": "云随雁字长。",
          "hant": "雲隨雁字長。"
        },
        {
          "id": "line-3",
          "hans": "绿杯红袖称重阳。",
          "hant": "綠杯紅袖稱重陽。"
        },
        {
          "id": "line-4",
          "hans": "人情似故乡。",
          "hant": "人情似故鄉。"
        },
        {
          "id": "line-5",
          "hans": "兰佩紫，菊簪黄。",
          "hant": "蘭佩紫，菊簪黃。"
        },
        {
          "id": "line-6",
          "hans": "殷勤理旧狂。",
          "hant": "殷勤理舊狂。"
        },
        {
          "id": "line-7",
          "hans": "欲将沈醉换悲凉。",
          "hant": "欲將沈醉換悲涼。"
        },
        {
          "id": "line-8",
          "hans": "清歌莫断肠。",
          "hant": "清歌莫斷腸。"
        }
      ]
    }
  ],
