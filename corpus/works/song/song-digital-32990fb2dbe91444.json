      "lines": [
        {
          "id": "line-1",
          "hans": "哀筝一弄湘江曲。",
          "hant": "哀箏一弄湘江曲。"
        },
        {
          "id": "line-2",
          "hans": "声声写尽湘波绿。",
          "hant": "聲聲寫盡湘波綠。"
        },
        {
          "id": "line-3",
          "hans": "纤指十三弦。",
          "hant": "纖指十三絃。"
        },
        {
          "id": "line-4",
          "hans": "细将幽恨传。",
          "hant": "細將幽恨傳。"
        },
        {
          "id": "line-5",
          "hans": "当筵秋水慢。",
          "hant": "當筵秋水慢。"
        },
        {
          "id": "line-6",
          "hans": "玉柱斜飞雁。",
          "hant": "玉柱斜飛雁。"
        },
        {
          "id": "line-7",
          "hans": "弹到断肠时。",
          "hant": "彈到斷腸時。"
        },
        {
          "id": "line-8",
          "hans": "春山眉黛低。",
          "hant": "春山眉黛低。"
        }
      ]
    }
  ],
