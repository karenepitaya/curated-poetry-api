      "lines": [
        {
          "id": "line-1",
          "hans": "落花已作风前舞。",
          "hant": "落花已作風前舞。"
        },
        {
          "id": "line-2",
          "hans": "又送黄昏雨。",
          "hant": "又送黃昏雨。"
        },
        {
          "id": "line-3",
          "hans": "晓来庭院半残红。",
          "hant": "曉來庭院半殘紅。"
        },
        {
          "id": "line-4",
          "hans": "惟有游丝千丈、晴空。",
          "hant": "惟有遊絲千丈、晴空。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "殷勤花下同携手。",
          "hant": "殷勤花下同攜手。"
        },
        {
          "id": "line-6",
          "hans": "更尽杯中酒。",
          "hant": "更盡杯中酒。"
        },
        {
          "id": "line-7",
          "hans": "美人不用敛蛾眉。",
          "hant": "美人不用斂蛾眉。"
        },
        {
          "id": "line-8",
          "hans": "我亦多情、无奈酒阑时。",
          "hant": "我亦多情、無奈酒闌時。"
        }
      ]
    }
  ],
