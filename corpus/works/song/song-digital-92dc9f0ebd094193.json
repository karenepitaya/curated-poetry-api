  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "庾郎先自吟愁赋。",
          "hant": "庾郎先自吟愁賦。"
        },
        {
          "id": "line-2",
          "hans": "凄凄更闻私语。",
          "hant": "悽悽更聞私語。"
        },
        {
          "id": "line-3",
          "hans": "露湿铜铺，苔侵石井，都是曾听伊处。",
          "hant": "露溼銅鋪，苔侵石井，都是曾聽伊處。"
        },
        {
          "id": "line-4",
          "hans": "哀音似诉。",
          "hant": "哀音似訴。"
        },
        {
          "id": "line-5",
          "hans": "正思妇无眠，起寻机杼。",
          "hant": "正思婦無眠，起尋機杼。"
        },
        {
          "id": "line-6",
          "hans": "曲曲屏山，夜凉独自甚情绪。",
          "hant": "曲曲屏山，夜涼獨自甚情緒。"
        },
        {
          "id": "line-7",
          "hans": "西窗又吹暗雨。",
          "hant": "西窗又吹暗雨。"
        },
        {
          "id": "line-8",
          "hans": "为谁频断续，相和砧杵。",
          "hant": "爲誰頻斷續，相和砧杵。"
        },
        {
          "id": "line-9",
          "hans": "候馆迎秋，离宫吊月，别有伤心无数。",
          "hant": "候館迎秋，離宮吊月，別有傷心無數。"
        },
        {
          "id": "line-10",
          "hans": "豳诗漫与。",
          "hant": "豳詩漫與。"
        },
        {
          "id": "line-11",
          "hans": "笑篱落呼灯，世间儿女。",
          "hant": "笑籬落呼燈，世間兒女。"
        },
        {
          "id": "line-12",
          "hans": "写入琴丝，一声声更苦。",
          "hant": "寫入琴絲，一聲聲更苦。"
        }
      ]
    }
  ],
