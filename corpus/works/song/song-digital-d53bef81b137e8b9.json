  },
  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "听风听雨过清明。",
          "hant": "聽風聽雨過清明。"
        },
        {
          "id": "line-2",
          "hans": "愁草瘗花铭。",
          "hant": "愁草瘞花銘。"
        },
        {
          "id": "line-3",
          "hans": "楼前绿暗分携路，一丝柳、一寸柔情。",
          "hant": "樓前綠暗分攜路，一絲柳、一寸柔情。"
        },
        {
          "id": "line-4",
          "hans": "料峭春寒中酒，交加晓梦啼莺。",
          "hant": "料峭春寒中酒，交加曉夢啼鶯。"
        },
        {
          "id": "line-5",
          "hans": "西园日日扫林亭。",
          "hant": "西園日日掃林亭。"
        },
        {
          "id": "line-6",
          "hans": "依旧赏新晴。",
          "hant": "依舊賞新晴。"
        },
        {
          "id": "line-7",
          "hans": "黄蜂频扑秋千索，有当时、纤手香凝。",
          "hant": "黃蜂頻撲鞦韆索，有當時、纖手香凝。"
        },
        {
          "id": "line-8",
          "hans": "惆怅双鸳不到，幽阶一夜苔生。",
          "hant": "惆悵雙鴛不到，幽階一夜苔生。"
        }
      ]
    }
  ],
