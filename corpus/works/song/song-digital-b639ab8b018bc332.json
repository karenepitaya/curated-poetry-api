      "lines": [
        {
          "id": "line-1",
          "hans": "我住长江头，君住长江尾。",
          "hant": "我住長江頭，君住長江尾。"
        },
        {
          "id": "line-2",
          "hans": "日日思君不见君，共饮长江水。",
          "hant": "日日思君不見君，共飲長江水。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-3",
          "hans": "此水几时休，此恨何时已。",
          "hant": "此水幾時休，此恨何時已。"
        },
        {
          "id": "line-4",
          "hans": "只愿君心似我心，定不负相思意。",
          "hant": "只願君心似我心，定不負相思意。"
        }
      ]
    }
  ],
