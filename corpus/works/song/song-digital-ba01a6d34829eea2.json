  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "芙蓉落尽天涵水。",
          "hant": "芙蓉落盡天涵水。"
        },
        {
          "id": "line-2",
          "hans": "日暮沧波起。",
          "hant": "日暮滄波起。"
        },
        {
          "id": "line-3",
          "hans": "背飞双燕帖云寒。",
          "hant": "背飛雙燕帖雲寒。"
        },
        {
          "id": "line-4",
          "hans": "独向小楼东畔、倚阑看。",
          "hant": "獨向小樓東畔、倚闌看。"
        },
        {
          "id": "line-5",
          "hans": "浮生只合尊前老。",
          "hant": "浮生只合尊前老。"
        },
        {
          "id": "line-6",
          "hans": "雪满长安道。",
          "hant": "雪滿長安道。"
        },
        {
          "id": "line-7",
          "hans": "故人早晚上高台。",
          "hant": "故人早晚上高臺。"
        },
        {
          "id": "line-8",
          "hans": "赠我江南春色、一枝梅。",
          "hant": "贈我江南春色、一枝梅。"
        }
      ]
    }
  ],
