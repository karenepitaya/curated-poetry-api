      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "晚晴风歇。",
          "hant": "晚晴風歇。"
        },
        {
          "id": "line-2",
          "hans": "一夜春折威。",
          "hant": "一夜春折威。"
        },
        {
          "id": "line-3",
          "hans": "脉脉花疏天淡，云来去、数枝雪。",
          "hant": "脈脈花疏天淡，雲來去、數枝雪。"
        },
        {
          "id": "line-4",
          "hans": "胜绝。",
          "hant": "勝絕。"
        },
        {
          "id": "line-5",
          "hans": "愁亦绝。",
          "hant": "愁亦絕。"
        },
        {
          "id": "line-6",
          "hans": "此情谁共说。",
          "hant": "此情誰共說。"
        },
        {
          "id": "line-7",
          "hans": "惟有两行低雁，知人倚、画楼月。",
          "hant": "惟有兩行低雁，知人倚、畫樓月。"
        }
      ]
    }
  ],
