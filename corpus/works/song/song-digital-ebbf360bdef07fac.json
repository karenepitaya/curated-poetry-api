      "lines": [
        {
          "id": "line-1",
          "hans": "漠漠轻寒上小楼。",
          "hant": "漠漠輕寒上小樓。"
        },
        {
          "id": "line-2",
          "hans": "晓阴无赖似穷秋。",
          "hant": "曉陰無賴似窮秋。"
        },
        {
          "id": "line-3",
          "hans": "淡烟流水画屏幽。",
          "hant": "淡煙流水畫屏幽。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "自在飞花轻似梦，无边丝雨细如愁。",
          "hant": "自在飛花輕似夢，無邊絲雨細如愁。"
        },
        {
          "id": "line-5",
          "hans": "宝帘闲挂小银钩。",
          "hant": "寶簾閒掛小銀鉤。"
        }
      ]
    }
  ],
