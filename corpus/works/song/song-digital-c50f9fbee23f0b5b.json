      "lines": [
        {
          "id": "line-4",
          "hans": "巧笑艳歌皆我意，恼花颠酒拼君嗔。",
          "hant": "巧笑豔歌皆我意，惱花顛酒拼君嗔。"
        },
        {
          "id": "line-5",
          "hans": "物情惟有醉中真。",
          "hant": "物情惟有醉中真。"
        }
