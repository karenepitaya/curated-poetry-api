          "hans": "不信芳春厌老人。",
          "hant": "不信芳春厭老人。"
        },
        {
          "id": "line-2",
          "hans": "老人几度送春归。",
          "hant": "老人幾度送春歸。"
        },
        {
          "id": "line-3",
          "hans": "惜春行乐莫辞频。",
          "hant": "惜春行樂莫辭頻。"
        }
