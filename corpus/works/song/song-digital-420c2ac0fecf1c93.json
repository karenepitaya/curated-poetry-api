      "lines": [
        {
          "id": "line-1",
          "hans": "凝碧旧池头，一听管弦凄切。",
          "hant": "凝碧舊池頭，一聽管絃悽切。"
        },
        {
          "id": "line-2",
          "hans": "多少梨园声在，总不堪华发。",
          "hant": "多少梨園聲在，總不堪華髮。"
        },
        {
          "id": "line-3",
          "hans": "杏花无处避春愁，也傍野烟发。",
          "hant": "杏花無處避春愁，也傍野煙發。"
        },
        {
          "id": "line-4",
          "hans": "惟有御沟声断，似知人呜咽。",
          "hant": "惟有御溝聲斷，似知人嗚咽。"
        }
      ]
    }
  ],
