  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "秋江带雨，寒沙萦水，人瞰画阁愁独。",
          "hant": "秋江帶雨，寒沙縈水，人瞰畫閣愁獨。"
        },
        {
          "id": "line-2",
          "hans": "烟蓑散响惊诗思，还被乱鸥飞去，秀句难续。",
          "hant": "煙蓑散響驚詩思，還被亂鷗飛去，秀句難續。"
        },
        {
          "id": "line-3",
          "hans": "冷眼尽归图画上，认隔岸、微茫云屋。",
          "hant": "冷眼盡歸圖畫上，認隔岸、微茫雲屋。"
        },
        {
          "id": "line-4",
          "hans": "想半属、渔市樵村，欲暮竞然竹。",
          "hant": "想半屬、漁市樵村，欲暮競然竹。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "须信风流未老，凭持酒、慰此凄凉心目。",
          "hant": "須信風流未老，憑持酒、慰此淒涼心目。"
        },
        {
          "id": "line-6",
          "hans": "一鞭南陌，几篙官渡，赖有歌眉舒绿。",
          "hant": "一鞭南陌，幾篙官渡，賴有歌眉舒綠。"
        },
        {
          "id": "line-7",
          "hans": "只匆匆眺远，早觉闲愁挂乔木。",
          "hant": "只匆匆眺遠，早覺閒愁掛喬木。"
        },
        {
          "id": "line-8",
          "hans": "应难奈，故人天际，望彻淮山，相思无雁足。",
          "hant": "應難奈，故人天際，望徹淮山，相思無雁足。"
        }
      ]
    }
  ],
