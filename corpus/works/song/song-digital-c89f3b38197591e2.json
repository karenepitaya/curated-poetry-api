  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "独倚危楼风细细。",
          "hant": "獨倚危樓風細細。"
        },
        {
          "id": "line-2",
          "hans": "望极离愁，黯黯生天际。",
          "hant": "望極離愁，黯黯生天際。"
        },
        {
          "id": "line-3",
          "hans": "草色山光残照里。",
          "hant": "草色山光殘照裏。"
        },
        {
          "id": "line-4",
          "hans": "无人会得凭阑意。",
          "hant": "無人會得憑闌意。"
        },
        {
          "id": "line-5",
          "hans": "也拟疏狂图一醉。",
          "hant": "也擬疏狂圖一醉。"
        },
        {
          "id": "line-6",
          "hans": "对酒当歌，强饮还无味。",
          "hant": "對酒當歌，強飲還無味。"
        },
        {
          "id": "line-7",
          "hans": "衣带渐宽都不悔。",
          "hant": "衣帶漸寬都不悔。"
        },
        {
          "id": "line-8",
          "hans": "况伊销得人憔悴。",
          "hant": "況伊銷得人憔悴。"
        }
      ]
    }
  ],
