      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "夜饮东坡醒复醉，归来仿佛三更。",
          "hant": "夜飲東坡醒復醉，歸來彷彿三更。"
        },
        {
          "id": "line-2",
          "hans": "家童鼻息已雷鸣。",
          "hant": "家童鼻息已雷鳴。"
        },
        {
          "id": "line-3",
          "hans": "敲门都不应，倚杖听江声。",
          "hant": "敲門都不應，倚杖聽江聲。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "长恨此身非我有，何时忘却营营。",
          "hant": "長恨此身非我有，何時忘卻營營。"
        },
        {
          "id": "line-5",
          "hans": "夜阑风静縠纹平。",
          "hant": "夜闌風靜縠紋平。"
        },
        {
          "id": "line-6",
          "hans": "小舟从此逝，江海寄馀生。",
          "hant": "小舟從此逝，江海寄餘生。"
        }
      ]
    }
  ],
