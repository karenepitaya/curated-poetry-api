  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "望处雨收云断，凭阑悄悄，目送秋光。",
          "hant": "望處雨收雲斷，憑闌悄悄，目送秋光。"
        },
        {
          "id": "line-2",
          "hans": "晚景萧疏，堪动宋玉悲凉。",
          "hant": "晚景蕭疏，堪動宋玉悲涼。"
        },
        {
          "id": "line-3",
          "hans": "水风轻、苹花渐老，月露冷、梧叶飘黄。",
          "hant": "水風輕、蘋花漸老，月露冷、梧葉飄黃。"
        },
        {
          "id": "line-4",
          "hans": "遣情伤。",
          "hant": "遣情傷。"
        },
        {
          "id": "line-5",
          "hans": "故人何在，烟水茫茫。",
          "hant": "故人何在，煙水茫茫。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-6",
          "hans": "难忘。",
          "hant": "難忘。"
        },
        {
          "id": "line-7",
          "hans": "文期酒会，几孤风月，屡变星霜。",
          "hant": "文期酒會，幾孤風月，屢變星霜。"
        },
        {
          "id": "line-8",
          "hans": "海阔山遥，未知何处是潇湘。",
          "hant": "海闊山遙，未知何處是瀟湘。"
        },
        {
          "id": "line-9",
          "hans": "念双燕、难凭远信，指暮天、空识归航。",
          "hant": "念雙燕、難憑遠信，指暮天、空識歸航。"
        },
        {
          "id": "line-10",
          "hans": "黯相望。",
          "hant": "黯相望。"
        },
        {
          "id": "line-11",
          "hans": "断鸿声里，立尽斜阳。",
          "hant": "斷鴻聲裏，立盡斜陽。"
        }
      ]
    }
  ],
