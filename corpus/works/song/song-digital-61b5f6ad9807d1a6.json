  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "条风布暖，霏雾弄晴，池塘遍满春色。",
          "hant": "條風布暖，霏霧弄晴，池塘遍滿春色。"
        },
        {
          "id": "line-2",
          "hans": "正是夜堂无月，沈沈暗寒食。",
          "hant": "正是夜堂無月，沈沈暗寒食。"
        },
        {
          "id": "line-3",
          "hans": "梁间燕，前社客。",
          "hant": "梁間燕，前社客。"
        },
        {
          "id": "line-4",
          "hans": "似笑我、闭门愁寂。",
          "hant": "似笑我、閉門愁寂。"
        },
        {
          "id": "line-5",
          "hans": "乱花过，隔院芸香，满地狼藉。",
          "hant": "亂花過，隔院芸香，滿地狼藉。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-6",
          "hans": "长记那回时，邂逅相逢，郊外驻油壁。",
          "hant": "長記那回時，邂逅相逢，郊外駐油壁。"
        },
        {
          "id": "line-7",
          "hans": "又见汉宫传烛，飞烟五候宅。",
          "hant": "又見漢宮傳燭，飛煙五候宅。"
        },
        {
          "id": "line-8",
          "hans": "青青草，迷路陌。",
          "hant": "青青草，迷路陌。"
        },
        {
          "id": "line-9",
          "hans": "强带酒，细寻前迹。",
          "hant": "強帶酒，細尋前跡。"
        },
        {
          "id": "line-10",
          "hans": "市桥远，柳下人家，犹自相识。",
          "hant": "市橋遠，柳下人家，猶自相識。"
        }
      ]
    }
  ],
