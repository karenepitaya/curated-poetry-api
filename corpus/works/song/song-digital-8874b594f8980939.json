      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "忆昔西池池上饮，年年多少欢娱。",
          "hant": "憶昔西池池上飲，年年多少歡娛。"
        },
        {
          "id": "line-2",
          "hans": "别来不寄一行书。",
          "hant": "別來不寄一行書。"
        },
        {
          "id": "line-3",
          "hans": "寻常相见了，犹道不如初。",
          "hant": "尋常相見了，猶道不如初。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "安稳锦屏今夜梦，月明好度江湖。",
          "hant": "安穩錦屏今夜夢，月明好度江湖。"
        },
        {
          "id": "line-5",
          "hans": "相思休问定何如。",
          "hant": "相思休問定何如。"
        },
        {
          "id": "line-6",
          "hans": "情知春去後，管得落花无。",
          "hant": "情知春去後，管得落花無。"
        }
      ]
    }
  ],
