  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "夜来雨。",
          "hant": "夜來雨。"
        },
        {
          "id": "line-2",
          "hans": "赖倩得、东风吹住。",
          "hant": "賴倩得、東風吹住。"
        },
        {
          "id": "line-3",
          "hans": "海棠正妖饶处。",
          "hant": "海棠正妖饒處。"
        },
        {
          "id": "line-4",
          "hans": "且留取。",
          "hant": "且留取。"
        },
        {
          "id": "line-5",
          "hans": "悄庭户。",
          "hant": "悄庭戶。"
        },
        {
          "id": "line-6",
          "hans": "试细听、莺啼燕语。",
          "hant": "試細聽、鶯啼燕語。"
        },
        {
          "id": "line-7",
          "hans": "分明共人愁绪。",
          "hant": "分明共人愁緒。"
        },
        {
          "id": "line-8",
          "hans": "怕春去。",
          "hant": "怕春去。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-9",
          "hans": "佳树。",
          "hant": "佳樹。"
        },
        {
          "id": "line-10",
          "hans": "翠阴初转午。",
          "hant": "翠陰初轉午。"
        },
        {
          "id": "line-11",
          "hans": "重帘未卷，乍睡起、寂寞看风絮。",
          "hant": "重簾未卷，乍睡起、寂寞看風絮。"
        },
        {
          "id": "line-12",
          "hans": "偷弹清泪寄烟波，见江头故人，为言憔悴如许。",
          "hant": "偷彈清淚寄煙波，見江頭故人，爲言憔悴如許。"
        },
        {
          "id": "line-13",
          "hans": "彩笺无数。",
          "hant": "彩箋無數。"
        },
        {
          "id": "line-14",
          "hans": "去却寒暄，到了浑无定据。",
          "hant": "去卻寒暄，到了渾無定據。"
        },
        {
          "id": "line-15",
          "hans": "断肠落日千山暮。",
          "hant": "斷腸落日千山暮。"
        }
      ]
    }
  ],
