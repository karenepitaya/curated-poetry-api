  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "牛渚天门险。",
          "hant": "牛渚天門險。"
        },
        {
          "id": "line-2",
          "hans": "限南北、七雄豪占。",
          "hant": "限南北、七雄豪佔。"
        },
        {
          "id": "line-3",
          "hans": "清雾敛。",
          "hant": "清霧斂。"
        },
        {
          "id": "line-4",
          "hans": "与闲人登览。",
          "hant": "與閒人登覽。"
        },
        {
          "id": "line-5",
          "hans": "待月上潮平波滟滟。",
          "hant": "待月上潮平波灩灩。"
        },
        {
          "id": "line-6",
          "hans": "塞管轻吹新《阿滥》。",
          "hant": "塞管輕吹新《阿濫》。"
        },
        {
          "id": "line-7",
          "hans": "风满槛。",
          "hant": "風滿檻。"
        },
        {
          "id": "line-8",
          "hans": "历历数、西州更点。",
          "hant": "歷歷數、西州更點。"
        }
      ]
    }
  ],
