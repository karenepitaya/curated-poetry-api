      "lines": [
        {
          "id": "line-1",
          "hans": "酣酣日脚紫烟浮。",
          "hant": "酣酣日腳紫煙浮。"
        },
        {
          "id": "line-2",
          "hans": "妍暖破轻裘。",
          "hant": "妍暖破輕裘。"
        },
        {
          "id": "line-3",
          "hans": "困人天色，醉人花气，午梦扶头。",
          "hant": "困人天色，醉人花氣，午夢扶頭。"
        },
        {
          "id": "line-4",
          "hans": "春慵恰似春塘水，一片縠纹愁。",
          "hant": "春慵恰似春塘水，一片縠紋愁。"
        },
        {
          "id": "line-5",
          "hans": "溶溶泄泄，东风无力，欲皱还休。",
          "hant": "溶溶泄泄，東風無力，欲皺還休。"
        }
      ]
    }
