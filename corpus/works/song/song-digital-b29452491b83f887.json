  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "薄雨初寒，斜照弄晴，春意空阔。",
          "hant": "薄雨初寒，斜照弄晴，春意空闊。"
        },
        {
          "id": "line-2",
          "hans": "长亭柳色缠黄，远客一枝先折。",
          "hant": "長亭柳色纏黃，遠客一枝先折。"
        },
        {
          "id": "line-3",
          "hans": "烟横水际，映带几点归鸦，东风销尽龙沙雪。",
          "hant": "煙橫水際，映帶幾點歸鴉，東風銷盡龍沙雪。"
        },
        {
          "id": "line-4",
          "hans": "还记初关来，恰而今时节。",
          "hant": "還記初關來，恰而今時節。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "将发。",
          "hant": "將發。"
        },
        {
          "id": "line-6",
          "hans": "画楼芳酒，红泪清歌，顿成清别。",
          "hant": "畫樓芳酒，紅淚清歌，頓成清別。"
        },
        {
          "id": "line-7",
          "hans": "已是经年，杳杳音尘多绝。",
          "hant": "已是經年，杳杳音塵多絕。"
        },
        {
          "id": "line-8",
          "hans": "欲知方寸，共有几许清愁，芭蕉不展丁香结。",
          "hant": "欲知方寸，共有幾許清愁，芭蕉不展丁香結。"
        },
        {
          "id": "line-9",
          "hans": "枉望断天涯，两厌厌风月。",
          "hant": "枉望斷天涯，兩厭厭風月。"
        }
      ]
    }
  ],
