  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "寒水依痕，春意渐回，沙际烟阔。",
          "hant": "寒水依痕，春意漸回，沙際煙闊。"
        },
        {
          "id": "line-2",
          "hans": "溪梅晴照生香，冷芯数枝争发。",
          "hant": "溪梅晴照生香，冷芯數枝爭發。"
        },
        {
          "id": "line-3",
          "hans": "天涯旧恨，试看几许消魂，长亭门外山重叠。",
          "hant": "天涯舊恨，試看幾許消魂，長亭門外山重疊。"
        },
        {
          "id": "line-4",
          "hans": "不尽眼中青，是愁来时节。",
          "hant": "不盡眼中青，是愁來時節。"
        },
        {
          "id": "line-5",
          "hans": "情切。",
          "hant": "情切。"
        },
        {
          "id": "line-6",
          "hans": "画楼深闭，想见东风，暗销肌雪。",
          "hant": "畫樓深閉，想見東風，暗銷肌雪。"
        },
        {
          "id": "line-7",
          "hans": "辜负枕前云雨，尊前花月。",
          "hant": "辜負枕前雲雨，尊前花月。"
        },
        {
          "id": "line-8",
          "hans": "心期切处，更有多少凄凉，殷勤留与归时说。",
          "hant": "心期切處，更有多少淒涼，殷勤留與歸時說。"
        },
        {
          "id": "line-9",
          "hans": "到得却相逢，恰经年离别。",
          "hant": "到得卻相逢，恰經年離別。"
        }
      ]
    }
  ],
