  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "翦红情，裁绿意，花信上钗股。",
          "hant": "翦紅情，裁綠意，花信上釵股。"
        },
        {
          "id": "line-2",
          "hans": "残日东风，不放岁华去。",
          "hant": "殘日東風，不放歲華去。"
        },
        {
          "id": "line-3",
          "hans": "有人添烛西窗，不眠侵晓，笑声转、新年莺语。",
          "hant": "有人添燭西窗，不眠侵曉，笑聲轉、新年鶯語。"
        },
        {
          "id": "line-4",
          "hans": "旧尊俎。",
          "hant": "舊尊俎。"
        },
        {
          "id": "line-5",
          "hans": "玉纤曾擘黄柑，柔香系幽素。",
          "hant": "玉纖曾擘黃柑，柔香系幽素。"
        },
        {
          "id": "line-6",
          "hans": "归梦湖边，还迷镜中路。",
          "hant": "歸夢湖邊，還迷鏡中路。"
        },
        {
          "id": "line-7",
          "hans": "可怜千点吴霜，寒销不尽，又相对、落梅如雨。",
          "hant": "可憐千點吳霜，寒銷不盡，又相對、落梅如雨。"
        }
      ]
    }
  ],
