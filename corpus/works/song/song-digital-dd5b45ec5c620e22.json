      "lines": [
        {
          "id": "line-1",
          "hans": "数声鶗鴂。",
          "hant": "數聲鶗鴂。"
        },
        {
          "id": "line-2",
          "hans": "可怜又是，春归时节。",
          "hant": "可憐又是，春歸時節。"
        },
        {
          "id": "line-3",
          "hans": "满院东风，海棠铺绣，梨花飘雪。",
          "hant": "滿院東風，海棠鋪繡，梨花飄雪。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "丁香露泣残枝，算未比、愁肠寸结。",
          "hant": "丁香露泣殘枝，算未比、愁腸寸結。"
        },
        {
          "id": "line-5",
          "hans": "自是休文，多情多感，不干风月。",
          "hant": "自是休文，多情多感，不幹風月。"
        }
      ]
    }
  ],
