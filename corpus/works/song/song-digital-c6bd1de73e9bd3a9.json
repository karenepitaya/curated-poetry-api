  "tune": {
    "hans": "凤箫吟・芳草",
    "hant": "鳳簫吟・芳草"
  },
  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "锁离愁，连绵无际，来时陌上初熏。",
          "hant": "鎖離愁，連綿無際，來時陌上初燻。"
        },
        {
          "id": "line-2",
          "hans": "绣帏人念远，暗垂珠泪，泣送征轮。",
          "hant": "繡幃人念遠，暗垂珠淚，泣送徵輪。"
        },
        {
          "id": "line-3",
          "hans": "长亭长在眼，更重重、远水孤云。",
          "hant": "長亭長在眼，更重重、遠水孤雲。"
        },
        {
          "id": "line-4",
          "hans": "但望极楼高，尽日目断王孙。",
          "hant": "但望極樓高，盡日目斷王孫。"
        },
        {
          "id": "line-5",
          "hans": "消魂。",
          "hant": "消魂。"
        },
        {
          "id": "line-6",
          "hans": "池塘别後，曾行处、绿妒轻裙。",
          "hant": "池塘別後，曾行處、綠妒輕裙。"
        },
        {
          "id": "line-7",
          "hans": "恁时携素手，乱花飞絮里，缓步香。",
          "hant": "恁時攜素手，亂花飛絮裏，緩步香。"
        },
        {
          "id": "line-8",
          "hans": "朱颜空自改，向年年、芳意长新。",
          "hant": "朱顏空自改，向年年、芳意長新。"
        },
        {
          "id": "line-9",
          "hans": "遍绿野，嬉游醉眠，莫负青春。",
          "hant": "遍綠野，嬉遊醉眠，莫負青春。"
        }
      ]
    }
  ],
