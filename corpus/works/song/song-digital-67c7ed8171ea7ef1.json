  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "陇首云飞，江边日晚，烟波满目凭阑久。",
          "hant": "隴首雲飛，江邊日晚，煙波滿目憑闌久。"
        },
        {
          "id": "line-2",
          "hans": "立望关河萧索，千里清秋。",
          "hant": "立望關河蕭索，千里清秋。"
        },
        {
          "id": "line-3",
          "hans": "忍凝眸。",
          "hant": "忍凝眸。"
        },
        {
          "id": "line-4",
          "hans": "杳杳神京，盈盈仙子，别来锦字终难偶。",
          "hant": "杳杳神京，盈盈仙子，別來錦字終難偶。"
        },
        {
          "id": "line-5",
          "hans": "断雁无凭，冉冉飞下汀洲。",
          "hant": "斷雁無憑，冉冉飛下汀洲。"
        },
        {
          "id": "line-6",
          "hans": "思悠悠。",
          "hant": "思悠悠。"
        },
        {
          "id": "line-7",
          "hans": "暗想当初，有多少、幽欢佳会，岂知聚散难期，翻成雨恨云愁。",
          "hant": "暗想當初，有多少、幽歡佳會，豈知聚散難期，翻成雨恨雲愁。"
        },
        {
          "id": "line-8",
          "hans": "阻追游。",
          "hant": "阻追遊。"
        },
        {
          "id": "line-9",
          "hans": "每登山临水，惹起平生心事，一场消黯，永日无言，却下层楼。",
          "hant": "每登山臨水，惹起平生心事，一場消黯，永日無言，卻下層樓。"
        }
      ]
    }
  ],
