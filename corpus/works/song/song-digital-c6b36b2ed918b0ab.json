      "lines": [
        {
          "id": "line-1",
          "hans": "燕鸿过後春归去。",
          "hant": "燕鴻過後春歸去。"
        },
        {
          "id": "line-2",
          "hans": "细算浮生千万绪。",
          "hant": "細算浮生千萬緒。"
        },
        {
          "id": "line-3",
          "hans": "来如春梦几多时，去似朝云无觅处。",
          "hant": "來如春夢幾多時，去似朝雲無覓處。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "闻琴解神仙侣。",
          "hant": "聞琴解神仙侶。"
        },
        {
          "id": "line-5",
          "hans": "挽断罗衣留不住。",
          "hant": "挽斷羅衣留不住。"
        },
        {
          "id": "line-6",
          "hans": "劝君莫作独醒人，烂醉花间应有数。",
          "hant": "勸君莫作獨醒人，爛醉花間應有數。"
        }
      ]
    }
  ],
