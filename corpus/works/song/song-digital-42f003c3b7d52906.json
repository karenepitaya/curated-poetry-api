  "tune": {
    "hans": "浪涛沙・浪淘沙",
    "hant": "浪濤沙・浪淘沙"
  },
  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "昼阴重，霜凋岸草，雾隐城堞。",
          "hant": "晝陰重，霜凋岸草，霧隱城堞。"
        },
        {
          "id": "line-2",
          "hans": "南陌脂车待发。",
          "hant": "南陌脂車待發。"
        },
        {
          "id": "line-3",
          "hans": "东门帐饮乍阕。",
          "hant": "東門帳飲乍闋。"
        },
        {
          "id": "line-4",
          "hans": "正拂面垂杨堪缆结。",
          "hant": "正拂面垂楊堪纜結。"
        },
        {
          "id": "line-5",
          "hans": "掩红泪、玉手亲折。",
          "hant": "掩紅淚、玉手親折。"
        },
        {
          "id": "line-6",
          "hans": "念汉浦离鸿去何许，经时信音绝。",
          "hant": "念漢浦離鴻去何許，經時信音絕。"
        },
        {
          "id": "line-7",
          "hans": "情切。",
          "hant": "情切。"
        },
        {
          "id": "line-8",
          "hans": "望中地远天阔。",
          "hant": "望中地遠天闊。"
        },
        {
          "id": "line-9",
          "hans": "向露冷风清，无人处、耿耿寒漏咽。",
          "hant": "向露冷風清，無人處、耿耿寒漏咽。"
        },
        {
          "id": "line-10",
          "hans": "嗟万事难忘，唯是轻别。",
          "hant": "嗟萬事難忘，唯是輕別。"
        },
        {
          "id": "line-11",
          "hans": "翠尊未竭。",
          "hant": "翠尊未竭。"
        },
        {
          "id": "line-12",
          "hans": "凭断云留取，西楼残月。",
          "hant": "憑斷雲留取，西樓殘月。"
        },
        {
          "id": "line-13",
          "hans": "罗带光销纹衾叠。",
          "hant": "羅帶光銷紋衾疊。"
        },
        {
          "id": "line-14",
          "hans": "连环解、旧香顿歇。",
          "hant": "連環解、舊香頓歇。"
        },
        {
          "id": "line-15",
          "hans": "怨歌永、琼壶敲尽缺。",
          "hant": "怨歌永、瓊壺敲盡缺。"
        },
        {
          "id": "line-16",
          "hans": "恨春去、不与人期，弄夜色，空馀满地梨花雪。",
          "hant": "恨春去、不與人期，弄夜色，空餘滿地梨花雪。"
        }
      ]
    }
  ],
