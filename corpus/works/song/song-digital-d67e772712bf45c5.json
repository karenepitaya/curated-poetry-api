  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "胡马嘶风，汉旗翻雪，彤云又吐，一竿残照。",
          "hant": "胡馬嘶風，漢旗翻雪，彤雲又吐，一竿殘照。"
        },
        {
          "id": "line-2",
          "hans": "古木连空，乱山无数，行尽暮沙衰草。",
          "hant": "古木連空，亂山無數，行盡暮沙衰草。"
        },
        {
          "id": "line-3",
          "hans": "星斗横幽馆，夜无眠、灯花空老。",
          "hant": "星斗橫幽館，夜無眠、燈花空老。"
        },
        {
          "id": "line-4",
          "hans": "雾浓香鸭，冰凝泪烛，霜天难晓。",
          "hant": "霧濃香鴨，冰凝淚燭，霜天難曉。"
        },
        {
          "id": "line-5",
          "hans": "长记晓妆才了，一杯未尽，离怀多少。",
          "hant": "長記曉妝才了，一杯未盡，離懷多少。"
        },
        {
          "id": "line-6",
          "hans": "醉里秋波，梦中朝雨，都是醒时烦恼。",
          "hant": "醉裏秋波，夢中朝雨，都是醒時煩惱。"
        },
        {
          "id": "line-7",
          "hans": "料有牵情处，忍思量、耳边曾道。",
          "hant": "料有牽情處，忍思量、耳邊曾道。"
        },
        {
          "id": "line-8",
          "hans": "甚时跃马归来，认得迎门轻笑。",
          "hant": "甚時躍馬歸來，認得迎門輕笑。"
        }
      ]
    }
  ],
