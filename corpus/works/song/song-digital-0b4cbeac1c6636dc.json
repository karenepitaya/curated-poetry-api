      "lines": [
        {
          "id": "line-1",
          "hans": "门隔花深梦旧游。",
          "hant": "門隔花深夢舊遊。"
        },
        {
          "id": "line-2",
          "hans": "夕阳无语燕归愁。",
          "hant": "夕陽無語燕歸愁。"
        },
        {
          "id": "line-3",
          "hans": "玉纤香动小帘钩。",
          "hant": "玉纖香動小簾鉤。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "落絮无声春堕泪，行云有影月含羞。",
          "hant": "落絮無聲春墮淚，行雲有影月含羞。"
        },
        {
          "id": "line-5",
          "hans": "东风临夜冷於秋。",
          "hant": "東風臨夜冷於秋。"
        }
      ]
    }
  ],
