  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "风悲画角，听单于、三弄落谯门。",
          "hant": "風悲畫角，聽單于、三弄落譙門。"
        },
        {
          "id": "line-2",
          "hans": "投宿征骑，飞雪满孤村。",
          "hant": "投宿徵騎，飛雪滿孤村。"
        },
        {
          "id": "line-3",
          "hans": "酒市渐闲灯火，正敲窗、乱叶舞纷纷。",
          "hant": "酒市漸閒燈火，正敲窗、亂葉舞紛紛。"
        },
        {
          "id": "line-4",
          "hans": "送数声惊雁，下离烟水，嘹唳度寒云。",
          "hant": "送數聲驚雁，下離煙水，嘹唳度寒雲。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "好在半胧溪月，到如今、无处不销魂。",
          "hant": "好在半朧溪月，到如今、無處不銷魂。"
        },
        {
          "id": "line-6",
          "hans": "故国梅花归梦，愁损绿罗裙。",
          "hant": "故國梅花歸夢，愁損綠羅裙。"
        },
        {
          "id": "line-7",
          "hans": "为问暗香闲艳，也相思、万点付啼痕。",
          "hant": "爲問暗香閒豔，也相思、萬點付啼痕。"
        },
        {
          "id": "line-8",
          "hans": "算翠屏应是，两眉馀恨倚黄昏。",
          "hant": "算翠屏應是，兩眉餘恨倚黃昏。"
        }
      ]
    }
  ],
