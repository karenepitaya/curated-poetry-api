      "lines": [
        {
          "id": "line-1",
          "hans": "缺月挂疏桐，漏断人初静。",
          "hant": "缺月掛疏桐，漏斷人初靜。"
        },
        {
          "id": "line-2",
          "hans": "时见幽人独往来，缥缈孤鸿影。",
          "hant": "時見幽人獨往來，縹緲孤鴻影。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-3",
          "hans": "惊起却回头，有恨无人省。",
          "hant": "驚起卻回頭，有恨無人省。"
        },
        {
          "id": "line-4",
          "hans": "拣尽寒枝不肯栖，枫落吴江冷。",
          "hant": "揀盡寒枝不肯棲，楓落吳江冷。"
        }
      ]
    }
  ],
