  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "戏马台前，采花篱下，问岁华、还是重九。",
          "hant": "戲馬臺前，採花籬下，問歲華、還是重九。"
        },
        {
          "id": "line-2",
          "hans": "恰归来、南山翠色依旧。",
          "hant": "恰歸來、南山翠色依舊。"
        },
        {
          "id": "line-3",
          "hans": "帘栊昨夜听风雨，都不似、登归时候。",
          "hant": "簾櫳昨夜聽風雨，都不似、登歸時候。"
        },
        {
          "id": "line-4",
          "hans": "一片宋玉情怀，十分卫郎清瘦。",
          "hant": "一片宋玉情懷，十分衛郎清瘦。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "红萸佩、空对酒。",
          "hant": "紅萸佩、空對酒。"
        },
        {
          "id": "line-6",
          "hans": "砧杆动微寒，暗欺罗袖。",
          "hant": "砧杆動微寒，暗欺羅袖。"
        },
        {
          "id": "line-7",
          "hans": "秋已无多，早是败荷衰柳。",
          "hant": "秋已無多，早是敗荷衰柳。"
        },
        {
          "id": "line-8",
          "hans": "强整帽檐侧，曾经向、天涯搔首。",
          "hant": "強整帽檐側，曾經向、天涯搔首。"
        },
        {
          "id": "line-9",
          "hans": "几回忆、故国莼鲈，霜前雁後。",
          "hant": "幾回憶、故國蓴鱸，霜前雁後。"
        }
      ]
    }
  ],
