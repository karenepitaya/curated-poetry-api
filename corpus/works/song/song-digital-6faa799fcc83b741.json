      "lines": [
        {
          "id": "line-1",
          "hans": "新月娟娟，夜寒江静山衔斗。",
          "hant": "新月娟娟，夜寒江靜山銜鬥。"
        },
        {
          "id": "line-2",
          "hans": "起来搔首。",
          "hant": "起來搔首。"
        },
        {
          "id": "line-3",
          "hans": "梅影横窗瘦。",
          "hant": "梅影橫窗瘦。"
        },
        {
          "id": "line-4",
          "hans": "好个霜天，闲却传杯手。",
          "hant": "好個霜天，閒卻傳杯手。"
        },
        {
          "id": "line-5",
          "hans": "君知否。",
          "hant": "君知否。"
        },
        {
          "id": "line-6",
          "hans": "乱鸦啼後。",
          "hant": "亂鴉啼後。"
        },
        {
          "id": "line-7",
          "hans": "归兴浓於酒。",
          "hant": "歸興濃於酒。"
        }
      ]
    }
