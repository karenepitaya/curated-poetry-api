  "tune": {
    "hans": "贺新郎",
    "hant": "賀新郎"
  },
  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "梦冷黄金屋。",
          "hant": "夢冷黃金屋。"
        },
        {
          "id": "line-2",
          "hans": "叹秦筝、斜鸿阵里，素弦尘扑。",
          "hant": "嘆秦箏、斜鴻陣裏，素弦塵撲。"
        },
        {
          "id": "line-3",
          "hans": "化作娇莺飞归去，犹认纱窗旧绿。",
          "hant": "化作嬌鶯飛歸去，猶認紗窗舊綠。"
        },
        {
          "id": "line-4",
          "hans": "正过雨、荆桃如菽。",
          "hant": "正過雨、荊桃如菽。"
        },
        {
          "id": "line-5",
          "hans": "此恨难平君知否，似琼台、涌起弹棋局。",
          "hant": "此恨難平君知否，似瓊臺、湧起彈棋局。"
        },
        {
          "id": "line-6",
          "hans": "消瘦影，嫌明烛。",
          "hant": "消瘦影，嫌明燭。"
        },
        {
          "id": "line-7",
          "hans": "鸳楼碎泻东西玉。",
          "hant": "鴛樓碎瀉東西玉。"
        },
        {
          "id": "line-8",
          "hans": "问芳、何时再展，翠钗难卜。",
          "hant": "問芳、何時再展，翠釵難卜。"
        },
        {
          "id": "line-9",
          "hans": "待把宫眉横云样，描上生绡画幅。",
          "hant": "待把宮眉橫雲樣，描上生綃畫幅。"
        },
        {
          "id": "line-10",
          "hans": "怕不是、新来妆束。",
          "hant": "怕不是、新來妝束。"
        },
        {
          "id": "line-11",
          "hans": "彩扇红牙今都在，恨无人、解听开元曲。",
          "hant": "彩扇紅牙今都在，恨無人、解聽開元曲。"
        },
        {
          "id": "line-12",
          "hans": "空掩袖，倚寒竹。",
          "hant": "空掩袖，倚寒竹。"
        }
      ]
    }
  ],
