  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "做冷欺花，将烟困柳，千里偷催春暮。",
          "hant": "做冷欺花，將煙困柳，千里偷催春暮。"
        },
        {
          "id": "line-2",
          "hans": "尽日冥迷，愁里欲飞还住。",
          "hant": "盡日冥迷，愁裏欲飛還住。"
        },
        {
          "id": "line-3",
          "hans": "惊粉重、蝶宿西园，喜泥润、燕归南浦。",
          "hant": "驚粉重、蝶宿西園，喜泥潤、燕歸南浦。"
        },
        {
          "id": "line-4",
          "hans": "最妨它、佳约风流，钿车不到杜陵路。",
          "hant": "最妨它、佳約風流，鈿車不到杜陵路。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "沈沈江上望极，还被春潮晚急，难寻官渡。",
          "hant": "沈沈江上望極，還被春潮晚急，難尋官渡。"
        },
        {
          "id": "line-6",
          "hans": "隐约遥峰，和泪谢娘眉妩。",
          "hant": "隱約遙峯，和淚謝娘眉嫵。"
        },
        {
          "id": "line-7",
          "hans": "临断岸、新绿生时，是落红、带愁流处。",
          "hant": "臨斷岸、新綠生時，是落紅、帶愁流處。"
        },
        {
          "id": "line-8",
          "hans": "记当日、门掩梨花，翦灯深夜语。",
          "hant": "記當日、門掩梨花，翦燈深夜語。"
        }
      ]
    }
  ],
