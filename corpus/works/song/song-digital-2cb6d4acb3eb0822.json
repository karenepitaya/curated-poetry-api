      "lines": [
        {
          "id": "line-1",
          "hans": "年年跃马长安市。",
          "hant": "年年躍馬長安市。"
        },
        {
          "id": "line-2",
          "hans": "客舍似家家似寄。",
          "hant": "客舍似家家似寄。"
        },
        {
          "id": "line-3",
          "hans": "青钱换酒日无何，红烛呼庐宵不寐。",
          "hant": "青錢換酒日無何，紅燭呼廬宵不寐。"
        },
        {
          "id": "line-4",
          "hans": "易挑锦妇机中字。",
          "hant": "易挑錦婦機中字。"
        },
        {
          "id": "line-5",
          "hans": "难得玉人心下事。",
          "hant": "難得玉人心下事。"
        },
        {
          "id": "line-6",
          "hans": "男儿西北有神州，莫滴水西桥畔泪。",
          "hant": "男兒西北有神州，莫滴水西橋畔淚。"
        }
      ]
    }
  ],
