  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "残雪庭阴，轻寒帘影，霏霏玉管春葭。",
          "hant": "殘雪庭陰，輕寒簾影，霏霏玉管春葭。"
        },
        {
          "id": "line-2",
          "hans": "小帖金泥，不知春在谁家。",
          "hant": "小帖金泥，不知春在誰家。"
        },
        {
          "id": "line-3",
          "hans": "相思一夜窗前梦，奈个人、水隔天遮。",
          "hant": "相思一夜窗前夢，奈個人、水隔天遮。"
        },
        {
          "id": "line-4",
          "hans": "但凄然，满树幽香，满地横斜。",
          "hant": "但悽然，滿樹幽香，滿地橫斜。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "江南自是离愁苦，况游骢古道，归雁平沙。",
          "hant": "江南自是離愁苦，況遊驄古道，歸雁平沙。"
        },
        {
          "id": "line-6",
          "hans": "怎得银笺，殷勤与说年华。",
          "hant": "怎得銀箋，殷勤與說年華。"
        },
        {
          "id": "line-7",
          "hans": "如今处处生芳草，纵凭高、不见天涯。",
          "hant": "如今處處生芳草，縱憑高、不見天涯。"
        },
        {
          "id": "line-8",
          "hans": "更消他，几度东风，几度飞花。",
          "hant": "更消他，幾度東風，幾度飛花。"
        }
      ]
    }
  ],
