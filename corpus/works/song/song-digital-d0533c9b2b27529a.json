      "lines": [
        {
          "id": "line-1",
          "hans": "清晨帘幕卷轻霜。",
          "hant": "清晨簾幕卷輕霜。"
        },
        {
          "id": "line-2",
          "hans": "呵手试梅妆。",
          "hant": "呵手試梅妝。"
        },
        {
          "id": "line-3",
          "hans": "都缘自有离恨，故画作远山长。",
          "hant": "都緣自有離恨，故畫作遠山長。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "思往事，惜流芳。",
          "hant": "思往事，惜流芳。"
        },
        {
          "id": "line-5",
          "hans": "易成伤。",
          "hant": "易成傷。"
        },
        {
          "id": "line-6",
          "hans": "拟歌先敛，欲笑还颦，最断人肠。",
          "hant": "擬歌先斂，欲笑還顰，最斷人腸。"
        }
      ]
    }
  ],
