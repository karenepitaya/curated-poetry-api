      "lines": [
        {
          "id": "line-1",
          "hans": "金风细细。",
          "hant": "金風細細。"
        },
        {
          "id": "line-2",
          "hans": "叶叶梧桐坠。",
          "hant": "葉葉梧桐墜。"
        },
        {
          "id": "line-3",
          "hans": "绿酒初尝人易醉。",
          "hant": "綠酒初嘗人易醉。"
        },
        {
          "id": "line-4",
          "hans": "一枕小窗浓睡。",
          "hant": "一枕小窗濃睡。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "紫微朱槿花残。",
          "hant": "紫微朱槿花殘。"
        },
        {
          "id": "line-6",
          "hans": "斜阳却照阑干。",
          "hant": "斜陽卻照闌干。"
        },
        {
          "id": "line-7",
          "hans": "双燕欲归时节，银屏昨夜微寒。",
          "hant": "雙燕欲歸時節，銀屏昨夜微寒。"
        }
      ]
    }
  ],
