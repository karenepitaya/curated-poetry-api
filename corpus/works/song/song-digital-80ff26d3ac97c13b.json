      "lines": [
        {
          "id": "line-1",
          "hans": "双蝶绣罗裙。",
          "hant": "雙蝶繡羅裙。"
        },
        {
          "id": "line-2",
          "hans": "东池宴。",
          "hant": "東池宴。"
        },
        {
          "id": "line-3",
          "hans": "初相见。",
          "hant": "初相見。"
        },
        {
          "id": "line-4",
          "hans": "朱粉不深匀。",
          "hant": "朱粉不深勻。"
        },
        {
          "id": "line-5",
          "hans": "闲花淡淡春。",
          "hant": "閒花淡淡春。"
        },
        {
          "id": "line-6",
          "hans": "细看诸处好。",
          "hant": "細看諸處好。"
        },
        {
          "id": "line-7",
          "hans": "人人道。",
          "hant": "人人道。"
        },
        {
          "id": "line-8",
          "hans": "柳腰身。",
          "hant": "柳腰身。"
        },
        {
          "id": "line-9",
          "hans": "昨日乱山昏。",
          "hant": "昨日亂山昏。"
        },
        {
          "id": "line-10",
          "hans": "来时衣上云。",
          "hant": "來時衣上雲。"
        }
      ]
    }
