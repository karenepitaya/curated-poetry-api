      "lines": [
        {
          "id": "line-1",
          "hans": "几许伤春春复暮。",
          "hant": "幾許傷春春復暮。"
        },
        {
          "id": "line-2",
          "hans": "杨柳清阴，偏碍游丝度。",
          "hant": "楊柳清陰，偏礙遊絲度。"
        },
        {
          "id": "line-3",
          "hans": "天际小山桃叶步。",
          "hant": "天際小山桃葉步。"
        },
        {
          "id": "line-4",
          "hans": "白苹花满湔裙处。",
          "hant": "白蘋花滿湔裙處。"
        },
        {
          "id": "line-5",
          "hans": "竟日微吟长短句。",
          "hant": "竟日微吟長短句。"
        },
        {
          "id": "line-6",
          "hans": "帘影灯昏，心寄胡琴语。",
          "hant": "簾影燈昏，心寄胡琴語。"
        },
        {
          "id": "line-7",
          "hans": "数点雨声风约住。",
          "hant": "數點雨聲風約住。"
        },
        {
          "id": "line-8",
          "hans": "朦胧淡月云来去。",
          "hant": "朦朧淡月雲來去。"
        }
      ]
    }
  ],
