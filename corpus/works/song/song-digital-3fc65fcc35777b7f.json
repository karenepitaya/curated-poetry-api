  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "曲阑干外天如水。",
          "hant": "曲闌干外天如水。"
        },
        {
          "id": "line-2",
          "hans": "昨夜还曾倚。",
          "hant": "昨夜還曾倚。"
        },
        {
          "id": "line-3",
          "hans": "初将明月比佳期。",
          "hant": "初將明月比佳期。"
        },
        {
          "id": "line-4",
          "hans": "长向月圆时候、望人归。",
          "hant": "長向月圓時候、望人歸。"
        },
        {
          "id": "line-5",
          "hans": "罗衣著破前香在。",
          "hant": "羅衣著破前香在。"
        },
        {
          "id": "line-6",
          "hans": "旧意谁教改。",
          "hant": "舊意誰教改。"
        },
        {
          "id": "line-7",
          "hans": "一春离恨懒调弦。",
          "hant": "一春離恨懶調絃。"
        },
        {
          "id": "line-8",
          "hans": "犹有两行闲泪、宝筝前。",
          "hant": "猶有兩行閒淚、寶箏前。"
        }
      ]
    }
  ],
