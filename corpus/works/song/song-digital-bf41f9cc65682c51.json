        {
          "id": "line-1",
          "hans": "波面铜花冷不收。",
          "hant": "波面銅花冷不收。"
        },
        {
          "id": "line-2",
          "hans": "玉人垂钓理纤钩。",
          "hant": "玉人垂釣理纖鉤。"
        },
        {
          "id": "line-3",
          "hans": "月明池阁夜来秋。",
          "hant": "月明池閣夜來秋。"
        },
        {
          "id": "line-4",
          "hans": "江燕话归成晓别，水花红减似春休。",
          "hant": "江燕話歸成曉別，水花紅減似春休。"
        },
        {
          "id": "line-5",
          "hans": "西风梧井叶先愁。",
          "hant": "西風梧井葉先愁。"
        }
      ]
    }
