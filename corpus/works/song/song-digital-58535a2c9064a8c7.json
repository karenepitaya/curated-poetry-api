      "lines": [
        {
          "id": "line-1",
          "hans": "楼角初销一缕霞。",
          "hant": "樓角初銷一縷霞。"
        },
        {
          "id": "line-2",
          "hans": "淡黄杨柳暗栖鸦。",
          "hant": "淡黃楊柳暗棲鴉。"
        },
        {
          "id": "line-3",
          "hans": "玉人和月摘梅花。",
          "hant": "玉人和月摘梅花。"
        },
        {
          "id": "line-4",
          "hans": "笑拈粉香归洞户，更垂帘幕护窗纱。",
          "hant": "笑拈粉香歸洞戶，更垂簾幕護窗紗。"
        },
        {
          "id": "line-5",
          "hans": "东风寒似夜来些。",
          "hant": "東風寒似夜來些。"
        }
      ]
    }
  ],
