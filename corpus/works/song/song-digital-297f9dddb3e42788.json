      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "闹红一舸，记来时、尝与鸳鸯为侣。",
          "hant": "鬧紅一舸，記來時、嘗與鴛鴦爲侶。"
        },
        {
          "id": "line-2",
          "hans": "三十六陂人未到，水佩风裳无数。",
          "hant": "三十六陂人未到，水佩風裳無數。"
        },
        {
          "id": "line-3",
          "hans": "翠叶吹凉，玉容销酒，更洒菰蒲雨。",
          "hant": "翠葉吹涼，玉容銷酒，更灑菰蒲雨。"
        },
        {
          "id": "line-4",
          "hans": "嫣然摇动，冷香飞上诗句。",
          "hant": "嫣然搖動，冷香飛上詩句。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "日暮。",
          "hant": "日暮。"
        },
        {
          "id": "line-6",
          "hans": "青盖亭亭，情人不见，争忍凌波去。",
          "hant": "青蓋亭亭，情人不見，爭忍凌波去。"
        },
        {
          "id": "line-7",
          "hans": "只恐舞衣寒易落，愁入西风南浦。",
          "hant": "只恐舞衣寒易落，愁入西風南浦。"
        },
        {
          "id": "line-8",
          "hans": "高柳垂阴，老鱼吹浪，留我花间住。",
          "hant": "高柳垂陰，老魚吹浪，留我花間住。"
        },
        {
          "id": "line-9",
          "hans": "田田多少，几回沙际归路。",
          "hant": "田田多少，幾回沙際歸路。"
        }
      ]
    }
  ],
