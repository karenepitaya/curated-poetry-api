  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "别後不知君远近。",
          "hant": "別後不知君遠近。"
        },
        {
          "id": "line-2",
          "hans": "触目凄凉多少闷。",
          "hant": "觸目淒涼多少悶。"
        },
        {
          "id": "line-3",
          "hans": "渐行渐远渐无书，水阔鱼沈何处问。",
          "hant": "漸行漸遠漸無書，水闊魚沈何處問。"
        },
        {
          "id": "line-4",
          "hans": "夜深风竹敲秋韵。",
          "hant": "夜深風竹敲秋韻。"
        },
        {
          "id": "line-5",
          "hans": "万叶千声皆是恨。",
          "hant": "萬葉千聲皆是恨。"
        },
        {
          "id": "line-6",
          "hans": "故欹单枕梦中寻，梦又不成灯又尽。",
          "hant": "故欹單枕夢中尋，夢又不成燈又盡。"
        }
      ]
    }
  ],
