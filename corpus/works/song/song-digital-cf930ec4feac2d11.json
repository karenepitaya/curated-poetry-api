  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "池塘水绿风微暖。",
          "hant": "池塘水綠風微暖。"
        },
        {
          "id": "line-2",
          "hans": "记得玉真初见面。",
          "hant": "記得玉真初見面。"
        },
        {
          "id": "line-3",
          "hans": "重头歌韵响铮琮，入破舞腰红乱旋。",
          "hant": "重頭歌韻響錚琮，入破舞腰紅亂旋。"
        },
        {
          "id": "line-4",
          "hans": "玉钩阑下香阶畔。",
          "hant": "玉鉤闌下香階畔。"
        },
        {
          "id": "line-5",
          "hans": "醉後不知斜日晚。",
          "hant": "醉後不知斜日晚。"
        },
        {
          "id": "line-6",
          "hans": "当时共我赏花人，点检如今无一半。",
          "hant": "當時共我賞花人，點檢如今無一半。"
        }
      ]
    }
  ],
