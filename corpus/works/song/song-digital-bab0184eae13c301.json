  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "人去西楼雁杳。",
          "hant": "人去西樓雁杳。"
        },
        {
          "id": "line-2",
          "hans": "叙别梦、扬州一觉。",
          "hant": "敘別夢、揚州一覺。"
        },
        {
          "id": "line-3",
          "hans": "云澹星疏楚山晓。",
          "hant": "雲澹星疏楚山曉。"
        },
        {
          "id": "line-4",
          "hans": "听啼乌，立河桥，话未了。",
          "hant": "聽啼烏，立河橋，話未了。"
        },
        {
          "id": "line-5",
          "hans": "雨外蛩声早。",
          "hant": "雨外蛩聲早。"
        },
        {
          "id": "line-6",
          "hans": "细织就、霜丝多少。",
          "hant": "細織就、霜絲多少。"
        },
        {
          "id": "line-7",
          "hans": "说与萧娘未知道。",
          "hant": "說與蕭娘未知道。"
        },
        {
          "id": "line-8",
          "hans": "向长安，对秋灯，几人老。",
          "hant": "向長安，對秋燈，幾人老。"
        }
      ]
    }
  ],
