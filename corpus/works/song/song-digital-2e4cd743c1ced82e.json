      "lines": [
        {
          "id": "line-1",
          "hans": "繁灯夺霁华。",
          "hant": "繁燈奪霽華。"
        },
        {
          "id": "line-2",
          "hans": "戏鼓侵明发。",
          "hant": "戲鼓侵明發。"
        },
        {
          "id": "line-3",
          "hans": "物色旧时同，情味中年别。",
          "hant": "物色舊時同，情味中年別。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-4",
          "hans": "浅画镜中眉，深拜楼西月。",
          "hant": "淺畫鏡中眉，深拜樓西月。"
        },
        {
          "id": "line-5",
          "hans": "人散市声收，渐入愁时节。",
          "hant": "人散市聲收，漸入愁時節。"
        }
      ]
    }
  ],
