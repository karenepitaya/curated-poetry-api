        {
          "id": "line-1",
          "hans": "赤阑桥尽香街直。",
          "hant": "赤闌橋盡香街直。"
        },
        {
          "id": "line-2",
          "hans": "笼街细柳娇无力。",
          "hant": "籠街細柳嬌無力。"
        },
        {
          "id": "line-3",
          "hans": "金碧上青空。",
          "hant": "金碧上青空。"
        },
        {
          "id": "line-4",
          "hans": "花晴帘影红。",
          "hant": "花晴簾影紅。"
        }
      ]
    },
    {
      "id": "stanza-2",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-5",
          "hans": "黄衫飞白马。",
          "hant": "黃衫飛白馬。"
        },
        {
          "id": "line-6",
          "hans": "日日青楼下。",
          "hant": "日日青樓下。"
        },
        {
          "id": "line-7",
          "hans": "醉眼不逢人。",
          "hant": "醉眼不逢人。"
        },
        {
          "id": "line-8",
          "hans": "午香吹暗尘。",
          "hant": "午香吹暗塵。"
        }
      ]
    }
  ],
