  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "伫倚危楼风细细。",
          "hant": "佇倚危樓風細細。"
        },
        {
          "id": "line-2",
          "hans": "望极春愁，黯黯生天际。",
          "hant": "望極春愁，黯黯生天際。"
        },
        {
          "id": "line-3",
          "hans": "草色烟光残照里。",
          "hant": "草色煙光殘照裏。"
        },
        {
          "id": "line-4",
          "hans": "无言谁会凭阑意。",
          "hant": "無言誰會憑闌意。"
        },
        {
          "id": "line-5",
          "hans": "拟把疏狂图一醉。",
          "hant": "擬把疏狂圖一醉。"
        },
        {
          "id": "line-6",
          "hans": "对酒当歌，强乐还无味。",
          "hant": "對酒當歌，強樂還無味。"
        },
        {
          "id": "line-7",
          "hans": "衣带渐宽终不悔。",
          "hant": "衣帶漸寬終不悔。"
        },
        {
          "id": "line-8",
          "hans": "为伊消得人憔悴。",
          "hant": "爲伊消得人憔悴。"
        }
      ]
    }
  ],
