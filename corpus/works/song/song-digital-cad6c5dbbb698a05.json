  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "篆缕销香鼎。",
          "hant": "篆縷銷香鼎。"
        },
        {
          "id": "line-2",
          "hans": "翠沈沈、庭阴转午，画堂人静。",
          "hant": "翠沈沈、庭陰轉午，畫堂人靜。"
        },
        {
          "id": "line-3",
          "hans": "芳草王孙知何处，惟有杨花糁径。",
          "hant": "芳草王孫知何處，惟有楊花糝徑。"
        },
        {
          "id": "line-4",
          "hans": "正玉枕、瞢腾初醒。",
          "hant": "正玉枕、瞢騰初醒。"
        },
        {
          "id": "line-5",
          "hans": "门外残红春已去，镇无聊、酒厌厌病。",
          "hant": "門外殘紅春已去，鎮無聊、酒厭厭病。"
        },
        {
          "id": "line-6",
          "hans": "云髻，未整。",
          "hant": "雲髻，未整。"
        },
        {
          "id": "line-7",
          "hans": "江南旧事休重省。",
          "hant": "江南舊事休重省。"
        },
        {
          "id": "line-8",
          "hans": "但天涯、寻消问息，断鸿难倩。",
          "hant": "但天涯、尋消問息，斷鴻難倩。"
        },
        {
          "id": "line-9",
          "hans": "月满西楼凭阑久，依旧归期未定。",
          "hant": "月滿西樓憑闌久，依舊歸期未定。"
        },
        {
          "id": "line-10",
          "hans": "便只恐、瓶沈金井。",
          "hant": "便只恐、瓶沈金井。"
        },
        {
          "id": "line-11",
          "hans": "嘶骑不来银烛暗，枉教人、立尽梧桐影。",
          "hant": "嘶騎不來銀燭暗，枉教人、立盡梧桐影。"
        },
        {
          "id": "line-12",
          "hans": "谁伴我，对鸾镜。",
          "hant": "誰伴我，對鸞鏡。"
        }
      ]
    }
  ],
