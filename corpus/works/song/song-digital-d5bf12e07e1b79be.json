        {
          "id": "line-1",
          "hans": "驿外断桥边，寂寞开无主。",
          "hant": "驛外斷橋邊，寂寞開無主。"
        },
        {
          "id": "line-2",
          "hans": "已是黄昏独自愁，更著风和雨。",
          "hant": "已是黃昏獨自愁，更著風和雨。"
        },
        {
          "id": "line-3",
          "hans": "无意苦争春，一任群芳妒。",
          "hant": "無意苦爭春，一任羣芳妒。"
        },
        {
          "id": "line-4",
          "hans": "零落成泥碾作尘，只有香如故。",
          "hant": "零落成泥碾作塵，只有香如故。"
        }
      ]
