  "sections": [
    {
      "id": "stanza-1",
      "kind": "stanza",
      "lines": [
        {
          "id": "line-1",
          "hans": "上马人扶残醉，晓风吹未醒。",
          "hant": "上馬人扶殘醉，曉風吹未醒。"
        },
        {
          "id": "line-2",
          "hans": "映水曲、翠瓦朱檐，垂杨里、乍见津亭。",
          "hant": "映水曲、翠瓦朱檐，垂楊裏、乍見津亭。"
        },
        {
          "id": "line-3",
          "hans": "当时曾题败壁，蛛丝罩、淡墨苔晕青。",
          "hant": "當時曾題敗壁，蛛絲罩、淡墨苔暈青。"
        },
        {
          "id": "line-4",
          "hans": "念去来、岁月如流，徘徊久、叹息愁思盈。",
          "hant": "念去來、歲月如流，徘徊久、嘆息愁思盈。"
        },
        {
          "id": "line-5",
          "hans": "去去倦寻路程。",
          "hant": "去去倦尋路程。"
        },
        {
          "id": "line-6",
          "hans": "江陵旧事，何曾再问杨琼。",
          "hant": "江陵舊事，何曾再問楊瓊。"
        },
        {
          "id": "line-7",
          "hans": "旧曲凄清。",
          "hant": "舊曲悽清。"
        },
        {
          "id": "line-8",
          "hans": "敛愁黛、与谁听。",
          "hant": "斂愁黛、與誰聽。"
        },
        {
          "id": "line-9",
          "hans": "尊前故人如在，想念我、最关情。",
          "hant": "尊前故人如在，想念我、最關情。"
        },
        {
          "id": "line-10",
          "hans": "何须渭城。",
          "hant": "何須渭城。"
        },
        {
          "id": "line-11",
          "hans": "歌声未尽处，先泪零。",
          "hant": "歌聲未盡處，先淚零。"
        }
      ]
    }
  ],
