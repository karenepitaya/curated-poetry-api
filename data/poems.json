{
  "poems": [
    {
      "id": "tang-wang-wei-lu-zhai",
      "title": "鹿柴",
      "titleTraditional": "鹿柴",
      "author": "王维",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["空山不见人", "但闻人语响", "返景入深林", "复照青苔上"],
      "versesTraditional": ["空山不見人", "但聞人語響", "返景入深林", "復照青苔上"]
    },
    {
      "id": "tang-wang-wei-zhu-li-guan",
      "title": "竹里馆",
      "titleTraditional": "竹里館",
      "author": "王维",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["独坐幽篁里", "弹琴复长啸", "深林人不知", "明月来相照"],
      "versesTraditional": ["獨坐幽篁裏", "彈琴復長嘯", "深林人不知", "明月來相照"]
    },
    {
      "id": "tang-wang-wei-song-bie",
      "title": "送别",
      "titleTraditional": "送別",
      "author": "王维",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["山中相送罢", "日暮掩柴扉", "春草明年绿", "王孙归不归"],
      "versesTraditional": ["山中相送罷", "日暮掩柴扉", "春草明年綠", "王孫歸不歸"]
    },
    {
      "id": "tang-wang-wei-xiang-si",
      "title": "相思",
      "titleTraditional": "相思",
      "author": "王维",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["红豆生南国", "春来发几枝", "愿君多采撷", "此物最相思"],
      "versesTraditional": ["紅豆生南國", "春來發幾枝", "願君多采擷", "此物最相思"]
    },
    {
      "id": "tang-pei-di-song-cui-jiu",
      "title": "送崔九",
      "titleTraditional": "送崔九",
      "author": "裴迪",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["归山深浅去", "须尽丘壑美", "莫学武陵人", "暂游桃源里"],
      "versesTraditional": ["歸山深淺去", "須盡丘壑美", "莫學武陵人", "暫遊桃源裏"]
    },
    {
      "id": "tang-zu-yong-zhong-nan-wang-yu-xue",
      "title": "终南望余雪",
      "titleTraditional": "終南望餘雪",
      "author": "祖咏",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["终南阴岭秀", "积雪浮云端", "林表明霁色", "城中增暮寒"],
      "versesTraditional": ["終南陰嶺秀", "積雪浮雲端", "林表明霽色", "城中增暮寒"]
    },
    {
      "id": "tang-meng-hao-ran-su-jian-de-jiang",
      "title": "宿建德江",
      "titleTraditional": "宿建德江",
      "author": "孟浩然",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["移舟泊烟渚", "日暮客愁新", "野旷天低树", "江清月近人"],
      "versesTraditional": ["移舟泊煙渚", "日暮客愁新", "野曠天低樹", "江清月近人"]
    },
    {
      "id": "tang-meng-hao-ran-chun-xiao",
      "title": "春晓",
      "titleTraditional": "春曉",
      "author": "孟浩然",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["春眠不觉晓", "处处闻啼鸟", "夜来风雨声", "花落知多少"],
      "versesTraditional": ["春眠不覺曉", "處處聞啼鳥", "夜來風雨聲", "花落知多少"]
    },
    {
      "id": "tang-li-bai-jing-ye-si",
      "title": "静夜思",
      "titleTraditional": "靜夜思",
      "author": "李白",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["床前明月光", "疑是地上霜", "举头望明月", "低头思故乡"],
      "versesTraditional": ["床前明月光", "疑是地上霜", "舉頭望明月", "低頭思故鄉"]
    },
    {
      "id": "tang-li-bai-yuan-qing",
      "title": "怨情",
      "titleTraditional": "怨情",
      "author": "李白",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["美人卷珠帘", "深坐颦蛾眉", "但见泪痕湿", "不知心恨谁"],
      "versesTraditional": ["美人捲珠簾", "深坐顰蛾眉", "但見淚痕濕", "不知心恨誰"]
    },
    {
      "id": "tang-du-fu-ba-zhen-tu",
      "title": "八阵图",
      "titleTraditional": "八陣圖",
      "author": "杜甫",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["功盖三分国", "名成八阵图", "江流石不转", "遗恨失吞吴"],
      "versesTraditional": ["功蓋三分國", "名成八陣圖", "江流石不轉", "遺恨失吞吳"]
    },
    {
      "id": "tang-wang-zhi-huan-deng-guan-que-lou",
      "title": "登鹳雀楼",
      "titleTraditional": "登鸛雀樓",
      "author": "王之涣",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["白日依山尽", "黄河入海流", "欲穷千里目", "更上一层楼"],
      "versesTraditional": ["白日依山盡", "黃河入海流", "欲窮千里目", "更上一層樓"]
    },
    {
      "id": "tang-liu-chang-qing-song-ling-che-shang-ren",
      "title": "送灵澈上人",
      "titleTraditional": "送靈澈上人",
      "author": "刘长卿",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["苍苍竹林寺", "杳杳钟声晚", "荷笠带斜阳", "青山独归远"],
      "versesTraditional": ["蒼蒼竹林寺", "杳杳鐘聲晚", "荷笠帶斜陽", "青山獨歸遠"]
    },
    {
      "id": "tang-liu-chang-qing-tan-qin",
      "title": "弹琴",
      "titleTraditional": "彈琴",
      "author": "刘长卿",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["泠泠七弦上", "静听松风寒", "古调虽自爱", "今人多不弹"],
      "versesTraditional": ["泠泠七絃上", "靜聽松風寒", "古調雖自愛", "今人多不彈"]
    },
    {
      "id": "tang-liu-chang-qing-song-shang-ren",
      "title": "送上人",
      "titleTraditional": "送上人",
      "author": "刘长卿",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["孤云将野鹤", "岂向人间住", "莫买沃洲山", "时人已知处"],
      "versesTraditional": ["孤雲將野鶴", "豈向人間住", "莫買沃洲山", "時人已知處"]
    },
    {
      "id": "tang-wei-ying-wu-qiu-ye-ji-qiu-yuan-wai",
      "title": "秋夜寄邱员外",
      "titleTraditional": "秋夜寄邱員外",
      "author": "韦应物",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["怀君属秋夜", "散步咏凉天", "空山松子落", "幽人应未眠"],
      "versesTraditional": ["懷君屬秋夜", "散步詠涼天", "空山松子落", "幽人應未眠"]
    },
    {
      "id": "tang-li-duan-ting-zheng",
      "title": "听筝",
      "titleTraditional": "聽箏",
      "author": "李端",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["鸣筝金粟柱", "素手玉房前", "欲得周郎顾", "时时误拂弦"],
      "versesTraditional": ["鳴箏金粟柱", "素手玉房前", "欲得周郎顧", "時時誤拂弦"]
    },
    {
      "id": "tang-wang-jian-xin-jia-niang-ci",
      "title": "新嫁娘词",
      "titleTraditional": "新嫁娘詞",
      "author": "王建",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["三日入厨下", "洗手作羹汤", "未谙姑食性", "先遣小姑尝"],
      "versesTraditional": ["三日入廚下", "洗手作羹湯", "未諳姑食性", "先遣小姑嘗"]
    },
    {
      "id": "tang-quan-de-yu-yu-tai-ti",
      "title": "玉台体",
      "titleTraditional": "玉臺體",
      "author": "权德舆",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["昨夜裙带解", "今朝蟢子飞", "铅华不可弃", "莫是藁砧归"],
      "versesTraditional": ["昨夜裙帶解", "今朝蟢子飛", "鉛華不可棄", "莫是藁砧歸"]
    },
    {
      "id": "tang-liu-zong-yuan-jiang-xue",
      "title": "江雪",
      "titleTraditional": "江雪",
      "author": "柳宗元",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["千山鸟飞绝", "万径人踪灭", "孤舟蓑笠翁", "独钓寒江雪"],
      "versesTraditional": ["千山鳥飛絕", "萬徑人蹤滅", "孤舟蓑笠翁", "獨釣寒江雪"]
    },
    {
      "id": "tang-yuan-zhen-xing-gong",
      "title": "行宫",
      "titleTraditional": "行宮",
      "author": "元稹",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["寥落古行宫", "宫花寂寞红", "白头宫女在", "闲坐说玄宗"],
      "versesTraditional": ["寥落古行宮", "宮花寂寞紅", "白頭宮女在", "閒坐說玄宗"]
    },
    {
      "id": "tang-bai-ju-yi-wen-liu-shi-jiu",
      "title": "问刘十九",
      "titleTraditional": "問劉十九",
      "author": "白居易",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["绿蚁新醅酒", "红泥小火炉", "晚来天欲雪", "能饮一杯无"],
      "versesTraditional": ["綠蟻新醅酒", "紅泥小火爐", "晚來天欲雪", "能飲一杯無"]
    },
    {
      "id": "tang-zhang-hu-he-man-zi",
      "title": "何满子",
      "titleTraditional": "何滿子",
      "author": "张祜",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["故国三千里", "深宫二十年", "一声何满子", "双泪落君前"],
      "versesTraditional": ["故國三千里", "深宮二十年", "一聲何滿子", "雙淚落君前"]
    },
    {
      "id": "tang-li-shang-yin-deng-le-you-yuan",
      "title": "登乐游原",
      "titleTraditional": "登樂遊原",
      "author": "李商隐",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["向晚意不适", "驱车登古原", "夕阳无限好", "只是近黄昏"],
      "versesTraditional": ["向晚意不適", "驅車登古原", "夕陽無限好", "只是近黃昏"]
    },
    {
      "id": "tang-jia-dao-xun-yin-zhe-bu-yu",
      "title": "寻隐者不遇",
      "titleTraditional": "尋隱者不遇",
      "author": "贾岛",
      "dynasty": "唐",
      "type": "五言绝句",
      "verses": ["松下问童子", "言师采药去", "只在此山中", "云深不知处"],
      "versesTraditional": ["松下問童子", "言師採藥去", "只在此山中", "雲深不知處"]
    },
    {
      "id": "tang-he-zhi-zhang-hui-xiang-ou-shu",
      "title": "回乡偶书",
      "titleTraditional": "回鄉偶書",
      "author": "贺知章",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["少小离家老大回", "乡音无改鬓毛催", "儿童相见不相识", "笑问客从何处来"],
      "versesTraditional": ["少小離家老大回", "鄉音無改鬢毛催", "兒童相見不相識", "笑問客從何處來"]
    },
    {
      "id": "tang-zhang-xu-tao-hua-xi",
      "title": "桃花溪",
      "titleTraditional": "桃花谿",
      "author": "张旭",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["隐隐飞桥隔野烟", "石矶西畔问渔船", "桃花尽日随流水", "洞在清溪何处边"],
      "versesTraditional": ["隱隱飛橋隔野煙", "石磯西畔問漁船", "桃花盡日隨流水", "洞在清谿何處邊"]
    },
    {
      "id": "tang-wang-chang-ling-fu-rong-lou-song-xin-jian",
      "title": "芙蓉楼送辛渐",
      "titleTraditional": "芙蓉樓送辛漸",
      "author": "王昌龄",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["寒雨连江夜入吴", "平明送客楚山孤", "洛阳亲友如相问", "一片冰心在玉壶"],
      "versesTraditional": ["寒雨連江夜入吳", "平明送客楚山孤", "洛陽親友如相問", "一片冰心在玉壺"]
    },
    {
      "id": "tang-wang-chang-ling-gui-yuan",
      "title": "闺怨",
      "titleTraditional": "閨怨",
      "author": "王昌龄",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["闺中少妇不知愁", "春日凝妆上翠楼", "忽见陌头杨柳色", "悔教夫婿觅封侯"],
      "versesTraditional": ["閨中少婦不知愁", "春日凝妝上翠樓", "忽見陌頭楊柳色", "悔教夫婿覓封侯"]
    },
    {
      "id": "tang-wang-chang-ling-chun-gong-qu",
      "title": "春宫曲",
      "titleTraditional": "春宮曲",
      "author": "王昌龄",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["昨夜风开露井桃", "未央前殿月轮高", "平阳歌舞新承宠", "帘外春寒赐锦袍"],
      "versesTraditional": ["昨夜風開露井桃", "未央前殿月輪高", "平陽歌舞新承寵", "簾外春寒賜錦袍"]
    },
    {
      "id": "tang-wang-han-liang-zhou-ci",
      "title": "凉州词",
      "titleTraditional": "涼州詞",
      "author": "王翰",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["葡萄美酒夜光杯", "欲饮琵琶马上催", "醉卧沙场君莫笑", "古来征战几人回"],
      "versesTraditional": ["葡萄美酒夜光杯", "欲飲琵琶馬上催", "醉臥沙場君莫笑", "古來征戰幾人回"]
    },
    {
      "id": "tang-li-bai-huang-he-lou-song-meng-hao-ran-zhi-guang-ling",
      "title": "黄鹤楼送孟浩然之广陵",
      "titleTraditional": "黃鶴樓送孟浩然之廣陵",
      "author": "李白",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["故人西辞黄鹤楼", "烟花三月下扬州", "孤帆远影碧山尽", "惟见长江天际流"],
      "versesTraditional": ["故人西辭黃鶴樓", "煙花三月下揚州", "孤帆遠影碧山盡", "惟見長江天際流"]
    },
    {
      "id": "tang-li-bai-zao-fa-bai-di-cheng",
      "title": "早发白帝城",
      "titleTraditional": "早發白帝城",
      "author": "李白",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["朝辞白帝彩云间", "千里江陵一日还", "两岸猿声啼不住", "轻舟已过万重山"],
      "versesTraditional": ["朝辭白帝彩雲間", "千里江陵一日還", "兩岸猿聲啼不住", "輕舟已過萬重山"]
    },
    {
      "id": "tang-cen-shen-feng-ru-jing-shi",
      "title": "逢入京使",
      "titleTraditional": "逢入京使",
      "author": "岑参",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["故园东望路漫漫", "双袖龙钟泪不干", "马上相逢无纸笔", "凭君传语报平安"],
      "versesTraditional": ["故園東望路漫漫", "雙袖龍鍾淚不乾", "馬上相逢無紙筆", "憑君傳語報平安"]
    },
    {
      "id": "tang-du-fu-jiang-nan-feng-li-gui-nian",
      "title": "江南逢李龟年",
      "titleTraditional": "江南逢李龜年",
      "author": "杜甫",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["岐王宅里寻常见", "崔九堂前几度闻", "正是江南好风景", "落花时节又逢君"],
      "versesTraditional": ["岐王宅裏尋常見", "崔九堂前幾度聞", "正是江南好風景", "落花時節又逢君"]
    },
    {
      "id": "tang-wei-ying-wu-chu-zhou-xi-jian",
      "title": "滁州西涧",
      "titleTraditional": "滁州西澗",
      "author": "韦应物",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["独怜幽草涧边生", "上有黄鹂深树鸣", "春潮带雨晚来急", "野渡无人舟自横"],
      "versesTraditional": ["獨憐幽草澗邊生", "上有黃鸝深樹鳴", "春潮帶雨晚來急", "野渡無人舟自橫"]
    },
    {
      "id": "tang-zhang-ji-feng-qiao-ye-bo",
      "title": "枫桥夜泊",
      "titleTraditional": "楓橋夜泊",
      "author": "张继",
      "dynasty": "唐",
      "type": "七言绝句",
      "verses": ["月落乌啼霜满天", "江枫渔火对愁眠", "姑苏城外寒山寺", "夜半钟声到客船"],
      "versesTraditional": ["月落烏啼霜滿天", "江楓漁火對愁眠", "姑蘇城外寒山寺", "夜半鐘聲到客船"]
    },
    {
      "id": "tang-han-hong-han-shi",
      "title": "寒食",
      "titleTraditional": "寒食",
      "author": "韩翃",
      "dynasty": "唐",
      "type": "七言绝句",
